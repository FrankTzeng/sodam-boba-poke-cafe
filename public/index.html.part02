    {n:"Beef Onigirazu", p:6.49, c:"rice", s:"Onigirazu (Japanese Rice Ball)", i:26, d:"Beef, avocado, cucumber, fried crunchy onion with spicy mayo, unagi sauce and furikake (Japanese seasoning).", g:["Beef", "Avocado", "Cucumber", "Fried crunchy onion", "Spicy mayo", "Unagi sauce", "Furikake"]},
    {n:"California Onigirazu", p:6.49, c:"rice", s:"Onigirazu (Japanese Rice Ball)", i:27, d:"Avocado, cucumber, imitation crab, spicy mayo and furikake (Japanese seasoning).", g:["Avocado", "Cucumber", "Imitation crab", "Spicy mayo", "Furikake"]},
