</div>

<script>
(function(){
  // Mobile nav
  var burger = document.getElementById('burger');
  var nav = document.getElementById('mainNav');
  burger.addEventListener('click', function(){
    var open = nav.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger.setAttribute('aria-label', open ? 'Close quick menu' : 'Open quick menu');
  });
  nav.addEventListener('click', function(e){
    if (e.target.tagName === 'A') { nav.classList.remove('open'); burger.setAttribute('aria-expanded','false'); burger.setAttribute('aria-label','Open quick menu'); }
  });
  // Keep the sticky menu filter bar pinned directly under the sticky site header
  var siteHeader = document.querySelector('header.site');
  function syncHeaderHeight(){
    if (siteHeader) document.documentElement.style.setProperty('--header-h', siteHeader.offsetHeight + 'px');
  }
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncHeaderHeight);
  // Duplicate ticker content for seamless loop
  var track = document.getElementById('tickerTrack');
  track.innerHTML += track.innerHTML;

  // Videos load lazily: nothing is fetched until a video nears the viewport,
  // so the page itself renders immediately (poster frames stand in until then).
  // They play only while on screen, and stay still for reduced-motion users.
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Polish micro-feedback: (re)starts a one-shot CSS animation class on
  // an element. Purely visual \u2014 it never touches the underlying action.
  function triggerAnimClass(el, className){
    if (!el || reduceMotion) return;
    el.classList.remove(className);
    void el.offsetWidth;
    el.classList.add(className);
    window.setTimeout(function(){ el.classList.remove(className); }, 400);
  }
  function bumpCartOnAdd(){
    triggerAnimClass(document.getElementById('cartBtn'), 'cart-bump');
    triggerAnimClass(document.getElementById('floatCartBtn'), 'cart-bump');
  }
  var lazyVids = Array.prototype.slice.call(document.querySelectorAll('video.lazyvid'));
  function loadVid(v){
    if (v.getAttribute('data-loaded')) return;
    v.setAttribute('data-loaded','1');
    var s = v.querySelector('source[data-src]');
    if (s) { s.src = s.getAttribute('data-src'); v.load(); }
  }
  if (!reduceMotion && 'IntersectionObserver' in window) {
    var vidIO = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        var v = en.target;
        if (en.isIntersecting) {
          loadVid(v);
          var p = v.play();
          if (p && p.catch) p.catch(function(){});
        } else if (v.getAttribute('data-loaded')) {
          v.pause();
        }
      });
    }, {rootMargin: '400px 0px'});
    lazyVids.forEach(function(v){ vidIO.observe(v); });
  } else if (!reduceMotion) {
    // No IntersectionObserver: load on scroll proximity fallback — just load all.
    lazyVids.forEach(function(v){ loadVid(v); var p = v.play(); if (p && p.catch) p.catch(function(){}); });
  }

  // ===== Full Toast menu: every item, in Toast order, with Toast prices & photos =====
  var BOWL_D = 'All bowls are served with all toppings included and come with a base of half rice and half spring mix.';
  var OKI_D = 'All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.';
  var BOWL_TOPPINGS = ['Avocado','Seaweed salad','Imitation crab','Cucumbers','Furikake','Lemon'];
  var OKI_PARTS = ['Rice','Spam','Egg','Spicy mayo','Eel sauce','Furikake','Nori'];
  var DRINK_TOPPINGS = ['Boba','Crystal boba','Lychee jelly','Strawberry popping boba','Mango jelly','Pudding'];
  var SWEETNESS = ['0% \u2014 No sugar','30% \u2014 Light','50% \u2014 Half','70% \u2014 Less sweet','100% \u2014 Regular'];
  var ICE_LEVELS = ['No ice','Less ice','Regular ice','Extra ice'];
  var BOWL_BASES = ['Half rice & half spring mix','All rice','All spring mix'];
  // Filling/flavor pickers for the collapsed duplicate rows (checked 2026-11-14): Toast's online listing does not name distinct fillings/flavors for these rows, so each set is collapsed into one item and the customer picks when ordering. No filling/flavor list for these rows is Toast-verified or owner-confirmed, so the picker offers a single "confirm with the cafe" choice and the customer writes the filling/flavor they want in the order notes — no invented names. Swap in the real list here once the owner confirms it.
  var CONFIRM_CHOICE = ['I\u2019ll confirm with the cafe'];
  var SUB_NOTES = {
    "Bowls": "All bowls include sushi rice, spring mix salad, avocado, seaweed salad, imitation crab, cucumbers, furikake, and lemon.",
    "Fruit Tea": "Fruit teas made fresh to order.",
    "Milk Tea (Over Ice)": "Served over ice \u2014 choose your sweetness and ice level, and add free toppings when you order.",
    "Milk Tea Blended": "Milk teas blended with ice.",
    "Onigiri / Okinawa Style": "All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.",
    "Onigiri Classic (Japanese Rice Balls)": "Classic triangular rice balls wrapped in nori.",
    "Slushies": "Blended fresh to order \u2014 choose your sweetness and add free toppings when you order.",
    "Smoothies": "Blended fresh to order \u2014 choose your sweetness and add free toppings when you order."
  };
  // n=name, p=price, c=tab category, s=Toast subcategory, i=Toast photo index (-1 = Toast has no photo for this item; the card shows 'Photo coming soon'), b=badge, d=Toast description, k=customize group key, g=ingredient list, o=1 means out of stock (Lavender Milk Tea Over Ice)
  // Photo check 2026-11-14: every i was verified against the actual photo contents. A few differ from Toast's menu order on purpose — Toast's photos came rotated between same-priced items (e.g. its spicy tuna photo sat on the beef bowl), so those items point at the Toast photo that actually depicts them.
  var MENU = [
    {n:"Spicy Salmon & Tuna Poke Bowl", p:14.99, c:"bowls", s:"Bowls", i:0, b:"OUR BESTSELLER!", d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Spicy Tuna Poke Bowl", p:14.99, c:"bowls", s:"Bowls", i:2, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Spicy Beef Bowl", p:14.99, c:"bowls", s:"Bowls", i:4, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Salmon & Tuna Poke Bowl", p:14.99, c:"bowls", s:"Bowls", i:1, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Tuna Poke Bowl", p:14.99, c:"bowls", s:"Bowls", i:3, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Beef Bowl", p:14.99, c:"bowls", s:"Bowls", i:5, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Spicy Tofu Bowl", p:13.99, c:"bowls", s:"Bowls", i:6, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"Tofu Bowl (Marinated with Sesame Dressing)", p:13.99, c:"bowls", s:"Bowls", i:7, d:"All bowls are served with all toppings included and come with a base of half rice and half spring mix.", k:"bowl"},
    {n:"3 pc Shrimp Tempura", p:2.00, c:"bowls", s:"Bowls", i:8, d:"Three pieces of shrimp tempura."},
    {n:"Spicy Tuna Poke Nacho with Tortilla Chips (*raw)", p:10.99, c:"bowls", s:"Poke Nacho with Tortilla Chips", i:9, d:"Fresh poke piled over crisp tortilla chips."},
    {n:"Tuna Poke Nacho with Tortilla Chips (*raw)", p:10.99, c:"bowls", s:"Poke Nacho with Tortilla Chips", i:10, d:"Fresh poke piled over crisp tortilla chips."},
    {n:"Loaded Spicy Tuna Poke Nacho with Tortilla Chips (*raw)", p:12.99, c:"bowls", s:"Poke Nacho with Tortilla Chips", i:11, d:"Fresh poke piled over crisp tortilla chips."},
    {n:"Loaded Tuna Poke Nacho with Tortilla Chips (*raw)", p:12.99, c:"bowls", s:"Poke Nacho with Tortilla Chips", i:12, d:"Fresh poke piled over crisp tortilla chips."},
    {n:"Spam & Egg Onigiri / Okinawa Style", p:5.49, c:"rice", s:"Onigiri / Okinawa Style", i:13, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Cheese Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:14, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Avocado Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:15, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Imitation Crab Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:16, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Seaweed Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:17, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Shrimp Tempura Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:18, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Spicy Tuna Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:19, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Marinated Beef Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:20, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Chicken Karaage Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:21, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Takoyaki Onigiri / Okinawa Style", p:6.49, c:"rice", s:"Onigiri / Okinawa Style", i:22, d:"All Onigiri / Okinawa Style come with rice, spam, egg, spicy mayo, eel sauce, furikake, nori, and your choice of topping.", k:"oki"},
    {n:"Spam & Cheese Onigirazu", p:6.49, c:"rice", s:"Onigirazu (Japanese Rice Ball)", i:23, d:"Spam, cheese, avocado, cucumber, spicy mayo, and furikake (Japanese seasoning).", g:["Spam", "Cheese", "Avocado", "Cucumber", "Spicy mayo", "Furikake"]},
    {n:"Shrimp Tempura Onigirazu", p:6.49, c:"rice", s:"Onigirazu (Japanese Rice Ball)", i:24, d:"Shrimp tempura, avocado, cucumber, fried crunchy onion with spicy mayo, unagi sauce and furikake (Japanese seasoning).", g:["Shrimp tempura", "Avocado", "Cucumber", "Fried crunchy onion", "Spicy mayo", "Unagi sauce", "Furikake"]},
