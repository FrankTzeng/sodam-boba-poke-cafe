<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="description" content="Sodam Boba & Poke Cafe — a small family-owned cafe in Torrance, CA serving generous poke bowls, Okinawa-style onigiri, onigirazu, and handcrafted boba drinks." />
<link rel="icon" href="data:," />
<title>Sodam Boba &amp; Poke Cafe — Torrance, CA</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
<style>
:root{
  --bg:#FBF7EC;
  --sand:#EFE6CF;
  --sand-2:#F5EFDD;
  --panel:#F1EAD6;
  --ink:#17301D;
  --ink-soft:#4C5B4A;
  --line:#DCD0B2;
  --green:#123B1E;
  --green-2:#1C5A2E;
  --green-deep:#0C2A15;
  --lime:#9CCF5F;
  --persimmon:#C8501F;
  --persimmon-deep:#A63E14;
  --badge-red:#C1272D;
  --card:#FFFDF6;
  --cream-on-dark:#F7F1DE;
  --shadow:0 14px 34px rgba(23,48,29,.12);
  --radius:12px;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#141B12;
    --sand:#1D271A;
    --sand-2:#1A2417;
    --panel:#22301F;
    --ink:#F0EAD2;
    --ink-soft:#BFC4AC;
    --line:#39452F;
    --green:#A9D68A;
    --green-2:#BFE3A3;
    --card:#1E2A1B;
    --persimmon:#F0925E;
    --persimmon-deep:#F5A87E;
    --badge-red:#E0483E;
    --shadow:0 14px 34px rgba(0,0,0,.5);
  }
}
*{box-sizing:border-box}
[hidden]{display:none !important}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto} }
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Jost",system-ui,sans-serif;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
img,video{display:block;max-width:100%}
img{filter:saturate(1.05) contrast(1.03) brightness(1.01)}
a{color:var(--green-2)}
h1,h2,h3,.disp{font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;line-height:1.08;margin:0;letter-spacing:.01em}
.wrap{max-width:1240px;margin:0 auto;padding:0 22px}
button,[role="button"],a.btn{min-height:44px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;border-radius:8px;font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.08em;padding:13px 28px;font-size:16px;border:2px solid transparent;cursor:pointer;transition:transform .15s ease,background .15s ease,color .15s ease}
.btn:active{transform:scale(.98)}
.btn-solid{background:var(--green);color:#F7F1DE}
.btn-solid:hover{background:var(--green-2)}
.btn-outline{background:transparent;color:var(--green);border-color:var(--green)}
.btn-outline:hover{background:var(--green);color:#F7F1DE}
.btn-light{background:var(--cream-on-dark);color:#123B1E}
.btn-light:hover{background:#fff}
.btn-outline-light{background:transparent;color:var(--cream-on-dark);border-color:rgba(247,241,222,.55)}
.btn-outline-light:hover{border-color:#fff;color:#fff}
@media (prefers-color-scheme: dark){
  .btn-outline{color:var(--ink);border-color:var(--ink)}
  .btn-outline:hover{background:var(--ink);color:#141B12}
  .btn-solid{background:#2E6B3C;color:#F7F1DE}
  .btn-solid:hover{background:#3A8149}
}

/* ---------- ticker ---------- */
.ticker{background:var(--lime);color:#123B1E;overflow:hidden;padding:9px 0}
.ticker-track{display:flex;width:max-content;animation:scrollx 28s linear infinite;font-family:"Oswald",sans-serif;font-weight:600;font-size:15.5px;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap}
.ticker-track span{padding:0 20px}
.ticker-track i{font-style:normal;opacity:.55}
@keyframes scrollx{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){ .ticker-track{animation:none} }

/* ---------- header ---------- */
header.site{position:relative;z-index:50;background:var(--sand);border-bottom:1px solid var(--line)}
.header-in{display:flex;flex-direction:column;align-items:stretch;gap:14px;padding:14px 0 14px;position:relative}
nav.main{display:none}
nav.main.open{display:flex;position:absolute;top:100%;left:0;right:0;z-index:60;background:var(--sand);flex-direction:column;padding:10px 22px 18px;border-bottom:1px solid var(--line);box-shadow:var(--shadow)}
nav.main a{text-decoration:none;color:var(--ink);font-family:"Oswald",sans-serif;font-size:15.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:13px 8px;border-radius:8px}
nav.main a:hover{color:var(--green-2);background:var(--sand-2)}
.wordmark{text-decoration:none;color:var(--ink);line-height:1;text-align:center;align-self:center}
.wordmark .name{font-family:"Oswald",sans-serif;font-weight:700;font-size:clamp(40px,9vw,60px);letter-spacing:.3em;margin-right:-.3em}
.wordmark .sub{display:block;font-size:14px;letter-spacing:.42em;text-transform:uppercase;color:var(--green-2);margin-top:7px;font-weight:600}
.header-actions{display:flex;align-items:center;gap:10px;width:100%;flex-wrap:nowrap}
.header-actions .ig-link{order:1}
.header-actions .phone-link{order:2}
.header-actions .search-toggle{order:3}
.header-actions .account-btn{order:4}
.header-actions .cart-btn{order:5}
.header-actions .burger{order:6;margin-left:auto}
.phone-link{display:inline-flex;align-items:center;gap:7px;text-decoration:none;color:var(--ink);font-weight:600;padding:10px 4px;font-size:15.5px;white-space:nowrap}
.phone-link:hover{color:var(--green-2)}
.ig-link{display:inline-flex;align-items:center;gap:8px;text-decoration:none;color:var(--ink);font-family:"Oswald",sans-serif;font-weight:600;font-size:13.5px;letter-spacing:.07em;text-transform:uppercase;padding:7px 14px 7px 8px;border:1.5px solid var(--line);border-radius:999px;background:var(--card);white-space:nowrap;line-height:1}
.ig-link svg{flex:none;display:block;border-radius:7px;box-shadow:0 3px 10px rgba(214,41,118,.38),0 1px 3px rgba(150,47,191,.28)}
.ig-link:hover{color:var(--green-2);border-color:#D62976}
.ig-link:hover svg{box-shadow:0 4px 14px rgba(214,41,118,.5),0 1px 4px rgba(150,47,191,.35)}
@media (prefers-color-scheme: dark){ .ig-link:hover{color:var(--green-2);border-color:#D62976} }
@media (max-width:1180px){ .ig-link .ig-follow{display:none} }
@media (max-width:640px){ .ig-link{width:44px;height:44px;min-height:44px;padding:0;justify-content:center} .ig-link .ig-text{display:none} }
.status-dot{width:9px;height:9px;border-radius:50%;background:#B0A696;flex:none;display:inline-block}
.status-dot.open{background:#5E9C3F;box-shadow:0 0 0 4px rgba(94,156,63,.22)}
.status-dot.closed{background:#C8501F;box-shadow:0 0 0 4px rgba(200,80,31,.18)}
.burger{background:var(--card);border:1.5px solid var(--line);border-radius:8px;width:44px;height:44px;min-height:44px;align-items:center;justify-content:center;cursor:pointer;color:var(--ink);flex:none;display:inline-flex}
.burger:hover{color:var(--green-2);border-color:var(--green-2)}
.burger[aria-expanded="true"]{background:var(--green);color:#F7F1DE;border-color:var(--green)}
@media (prefers-color-scheme: dark){ .burger[aria-expanded="true"]{background:#2E6B3C;color:#F7F1DE} }

/* ---------- header search ---------- */
.search-toggle{background:none;border:1px solid var(--line);border-radius:8px;width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--ink);flex:none}
.search-toggle:hover{color:var(--green-2);background:var(--sand-2)}
.search-toggle[aria-expanded="true"]{background:var(--green);color:#F7F1DE;border-color:var(--green)}
@media (prefers-color-scheme: dark){ .search-toggle[aria-expanded="true"]{background:#2E6B3C;color:#F7F1DE} }
.search-panel{border-top:1px solid var(--line);padding:12px 0 14px}
.search-row{display:flex;gap:10px;align-items:stretch}
.search-field{position:relative;flex:1;min-width:0}
.search-field>svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--ink-soft);pointer-events:none}
.search-field input{width:100%;min-height:48px;border:1.5px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font-family:inherit;font-size:16.5px;padding:11px 46px 11px 42px;-webkit-appearance:none;appearance:none}
.search-field input::-webkit-search-cancel-button{display:none}
.search-field input:focus{outline:2px solid var(--green-2);outline-offset:1px;border-color:var(--green-2)}
.search-clear{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:36px;height:36px;min-height:36px;border:none;border-radius:50%;background:var(--sand-2);color:var(--ink);font-size:20px;line-height:1;cursor:pointer;display:none;align-items:center;justify-content:center}
.search-clear.show{display:flex}
.search-done{font-family:"Oswald",sans-serif;font-size:14.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;background:transparent;color:var(--green);border:1.5px solid var(--green);border-radius:10px;padding:0 18px;min-height:48px;cursor:pointer;flex:none}
.search-done:hover{background:var(--green);color:#F7F1DE}
@media (prefers-color-scheme: dark){ .search-done{color:var(--ink);border-color:var(--ink)} .search-done:hover{background:var(--ink);color:#141B12} }
.search-status{font-size:14.5px;color:var(--ink-soft);margin:10px 2px 0}
.search-results{list-style:none;margin:2px 0 0;padding:0;max-height:308px;overflow-y:auto}
.search-result{display:flex;width:100%;align-items:baseline;gap:12px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:9px;padding:11px 14px;margin-top:8px;cursor:pointer;font:inherit;color:var(--ink);min-height:48px}
.search-result:hover{border-color:var(--green-2)}
.search-result .r-name{font-weight:600;flex:1;min-width:0}
.search-result .r-cat{color:var(--ink-soft);font-size:13.5px;white-space:nowrap}
.search-result .r-price{color:var(--persimmon);font-weight:700;white-space:nowrap}
@media (max-width:520px){ .search-result .r-cat{display:none} }
.menu-empty{grid-column:1/-1;text-align:center;color:var(--ink-soft);padding:30px 12px;font-size:16.5px}

/* ---------- hero ---------- */
.hero{background:var(--sand)}
.hero-in{display:grid;grid-template-columns:1.12fr .88fr;gap:48px;align-items:center;padding:44px 0 56px}
.hero-photo{margin:0}
.hero-photo img{width:100%;height:100%;max-height:540px;object-fit:cover;border-radius:10px;box-shadow:var(--shadow)} .hero-photo video{width:100%;height:100%;max-height:540px;object-fit:cover;display:block;background:var(--sand)}
.hero-photo figcaption{font-size:13.5px;color:var(--ink-soft);margin-top:10px;letter-spacing:.03em}
.hero h1{font-size:clamp(40px,4.6vw,62px);font-weight:700;color:var(--ink)}
.hero h1 em{font-style:normal;color:var(--green-2)}
.hero .lede{font-size:18.5px;font-weight:400;color:var(--ink-soft);max-width:32em;margin:18px 0 0}
.hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 26px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line);font-size:15px;color:var(--ink-soft)}
.hero-meta strong{color:var(--ink);font-weight:600}
.hero-meta .openline{display:inline-flex;align-items:center;gap:9px}

/* ---------- sections ---------- */
section.block{padding:72px 0}
.sec-head{max-width:760px;margin-bottom:38px}
.sec-head.center{margin-left:auto;margin-right:auto;text-align:center}
.sec-head .kicker{color:var(--persimmon);font-family:"Oswald",sans-serif;font-size:13px;letter-spacing:.3em;text-transform:uppercase;font-weight:600;margin:0 0 12px}
.sec-head h2{font-size:clamp(32px,4vw,48px);font-weight:700}
.sec-head p{color:var(--ink-soft);font-size:17.5px;margin:12px 0 0}

/* reels */
.reels{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.reel{position:relative;margin:0;border-radius:14px;overflow:hidden;background:var(--panel)}
.reel video{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:center}
.reel figcaption{position:absolute;left:12px;bottom:12px;right:12px;display:flex;align-items:center;justify-content:space-between;gap:8px}
.reel .rname{background:rgba(12,42,21,.82);color:#F7F1DE;font-family:"Oswald",sans-serif;font-size:13.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:7px 12px;border-radius:999px;backdrop-filter:blur(4px)}
.reel .rprice{background:var(--lime);color:#123B1E;font-weight:700;font-size:13.5px;padding:7px 11px;border-radius:999px;white-space:nowrap}

/* green statement band */
.band{background:var(--green);color:#DDEBCB;text-align:center;padding:30px 22px}
.band p{font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;font-size:clamp(22px,3.2vw,36px);letter-spacing:.04em;margin:0;line-height:1.2}
@media (prefers-color-scheme: dark){ .band{background:#2E6B3C} }

/* menu highlights */
#menu{scroll-margin-top:66px}
.menu-tabs{position:sticky;top:0;z-index:40;display:flex;flex-wrap:wrap;gap:6px 30px;justify-content:center;margin:0 -22px 28px;padding:8px 22px 6px;background:var(--bg);border-bottom:1px solid var(--line);box-shadow:0 10px 20px rgba(23,48,29,.07)}
.menu-tabs button{font-family:"Oswald",sans-serif;font-size:17px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:10px 2px;border:none;border-bottom:3px solid transparent;background:none;color:var(--ink-soft);cursor:pointer;min-height:44px}
.menu-tabs button:hover{color:var(--ink)}
.menu-tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--persimmon)}
.menu-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:22px 16px}
.menu-card{display:flex;flex-direction:column}
.menu-card h3{font-size:18.5px;font-weight:600;text-align:center;min-height:2.3em;display:flex;align-items:flex-end;justify-content:center;line-height:1.15}
.menu-card .photo{position:relative;background:var(--panel);border-radius:10px;overflow:hidden;margin-top:8px}
.menu-card .photo img{width:100%;aspect-ratio:4/3;object-fit:cover;filter:none}
.menu-card .price{color:var(--persimmon);font-weight:700;font-size:16.5px;text-align:center;margin-top:8px}
.menu-card p{color:var(--ink-soft);font-size:14px;text-align:center;margin:4px 0 0;flex:1;line-height:1.45}
.menu-card .btn{margin-top:10px;align-self:center;padding:10px 26px;font-size:14.5px}
.drinks-panel{margin-top:44px;background:var(--sand-2);border:1px solid var(--line);border-radius:var(--radius);padding:28px}
.drinks-panel h3{font-size:24px;text-align:center}
.drinks-panel .sig{text-align:center;color:var(--ink-soft);max-width:46em;margin:10px auto 0;font-size:16px}
.drinks-panel .sig strong{color:var(--ink)}
.drink-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}
.drink-item{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px}
.drink-item h4{font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;font-size:16.5px;margin:0 0 5px;letter-spacing:.03em}
.drink-item p{margin:0;color:var(--ink-soft);font-size:14.5px}
.drink-item .p{color:var(--persimmon);font-weight:700}
.drinks-banner{width:100%;aspect-ratio:21/9;object-fit:cover;border-radius:8px;margin-bottom:24px}
.menu-subhead{grid-column:1/-1;margin-top:18px}
.menu-subhead h3{font-size:24px}
.menu-subhead p{color:var(--ink-soft);font-size:15px;margin:4px 0 0;max-width:56em}
.menu-card{cursor:pointer}
.menu-card .photo-none{position:relative;aspect-ratio:4/3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:var(--sand-2);color:var(--green-2);border-radius:10px;margin-top:8px}
.menu-card .badge{align-self:center;background:var(--badge-red);color:#FFF7EA;font-family:"Oswald",sans-serif;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;padding:5px 12px;border-radius:999px;margin-bottom:-6px}
.menu-card .viewhint{font-family:"Oswald",sans-serif;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--green-2);text-align:center;margin-top:7px}
.menu-card .sim-note{font-size:12.5px;font-style:italic;color:var(--ink-soft);text-align:center;margin:6px 4px 0;line-height:1.4;flex:none}
.modal-sim-note{font-size:13.5px;font-style:italic;color:var(--ink-soft);background:var(--sand-2);border-top:1px solid var(--line);padding:10px 26px;margin:0}
.menu-cta{text-align:center;margin-top:44px}
/* item detail modal */
.modal-overlay{position:fixed;inset:0;background:rgba(12,26,14,.62);z-index:600;display:none;align-items:flex-end;justify-content:center;padding:0}
.modal-overlay.open{display:flex}
.modal{background:var(--bg);color:var(--ink);width:100%;max-width:640px;max-height:92vh;overflow-y:auto;border-radius:18px 18px 0 0;padding:0 0 28px;position:relative}
@media (min-width:700px){ .modal-overlay{align-items:center;padding:24px} .modal{border-radius:18px} }
.modal-photo{width:100%;aspect-ratio:16/10;object-fit:cover}
.modal-photo-none{aspect-ratio:16/10;display:flex;align-items:center;justify-content:center;background:var(--sand-2);color:var(--green-2)}
.modal-topbar{position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--bg);padding:10px 14px;border-bottom:1px solid var(--line);border-radius:18px 18px 0 0}
.modal-back{display:inline-flex;align-items:center;gap:9px;background:var(--green);color:#F7F1DE;border:none;border-radius:999px;padding:11px 20px;font-family:"Oswald",sans-serif;font-size:15.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;min-height:48px}
.modal-back:hover{background:var(--green-2)}
.modal-back svg{flex:none}
@media (prefers-color-scheme: dark){ .modal-back{background:#2E6B3C;color:#F7F1DE} .modal-back:hover{background:#3A8149} }
.modal-close{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--ink);font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;flex:none}
.modal-close:hover{background:var(--sand-2)}
.modal-body{padding:22px 26px 0}
.modal-badge{display:inline-block;background:var(--badge-red);color:#FFF7EA;font-family:"Oswald",sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;padding:5px 12px;border-radius:999px;margin-bottom:10px}
.modal-body h3{font-size:30px;line-height:1.15}
.modal-cat{color:var(--persimmon);font-family:"Oswald",sans-serif;font-size:13px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin:6px 0 0}
.modal-price{color:var(--persimmon);font-weight:700;font-size:21px;margin-top:8px}
.modal-desc{color:var(--ink-soft);font-size:16px;margin:10px 0 0}
.modal h4{font-family:"Oswald",sans-serif;font-size:19px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin:26px 0 4px}
.opt-group{margin-top:16px}
.opt-group h5{font-family:"Oswald",sans-serif;font-size:15px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin:0 0 8px}
.opt-list{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.opt{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);border-radius:9px;padding:11px 13px;font-size:15px;cursor:pointer;min-height:44px}
.opt input{width:19px;height:19px;accent-color:var(--green-2);flex:none}
.modal textarea{width:100%;border:1px solid var(--line);border-radius:9px;background:var(--card);color:var(--ink);font-family:inherit;font-size:16px;padding:12px;min-height:84px;resize:vertical}
.qty-row{display:flex;align-items:center;gap:16px;margin-top:22px;flex-wrap:wrap}
.qty{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--line);border-radius:999px;padding:4px}
.qty button{width:42px;height:42px;border-radius:50%;border:none;background:var(--sand-2);color:var(--ink);font-size:20px;cursor:pointer}
.qty output{font-weight:700;font-size:18px;min-width:34px;text-align:center}
.modal-order{flex:1;min-width:200px}
.modal-note{color:var(--ink-soft);font-size:13.5px;margin:12px 0 0}
@media (max-width:520px){ .opt-list{grid-template-columns:1fr} }

/* reaction carousel — one short horizontal swipe row */
.reaction-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:20px}
.reaction-head .sec-head{margin-bottom:0}
.reaction-controls{display:flex;gap:8px;flex:none;padding-bottom:4px}
.reaction-controls button{width:46px;height:46px;border-radius:50%;border:1.5px solid var(--green);background:transparent;color:var(--green);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .15s ease,color .15s ease}
.reaction-controls button:hover{background:var(--green);color:var(--cream-on-dark)}
@media (prefers-color-scheme: dark){ .reaction-controls button{border-color:var(--ink);color:var(--ink)} .reaction-controls button:hover{background:var(--ink);color:#141B12} }
.reaction-viewport{margin:0 -22px;padding:2px 22px 8px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-padding-left:22px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.reaction-viewport::-webkit-scrollbar{display:none}
.reaction-track{display:flex;gap:16px;width:max-content;max-width:none}
#reactionViewport .reaction-track{gap:12px}
.rcard{scroll-snap-align:start;flex:0 0 min(58vw,232px);display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;color:var(--ink);box-shadow:0 8px 22px rgba(23,48,29,.07)}
.reel-poster{display:block;position:relative;width:100%;aspect-ratio:16/10;flex:none;background:var(--panel);overflow:hidden;text-decoration:none}
.reel-poster img{width:100%;height:100%;object-fit:cover;display:block}
.reel-poster::after{content:"";position:absolute;inset:auto 0 0 0;height:44%;background:linear-gradient(transparent,rgba(12,42,21,.72));pointer-events:none}
.reel-poster-badge{position:absolute;left:8px;bottom:8px;z-index:2;display:inline-flex;align-items:center;gap:6px;background:rgba(12,42,21,.92);color:#F7F1DE;font-family:"Oswald",sans-serif;font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;padding:6px 9px;border-radius:999px;border:1px solid rgba(247,241,222,.5)}
.reel-poster-badge svg{width:13px;height:13px}
.reel-poster:hover .reel-poster-badge{background:var(--green-2)}
.reel-poster:focus-visible{outline:3px solid var(--lime);outline-offset:-3px}
.rcard-body{padding:11px 13px 13px;display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.rcard-body h3{font-size:15.5px;line-height:1.18}
.rcard-body .handle{color:var(--persimmon);font-weight:600;font-size:12.5px;line-height:1.35}
.rcard-body p{margin:2px 0 0;color:var(--ink-soft);font-size:13px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.rcard-body .watch{display:inline-flex;align-items:center;justify-content:center;gap:7px;margin-top:auto;min-height:44px;padding:10px 14px;background:var(--green);color:#F7F1DE;font-family:"Oswald",sans-serif;font-size:13.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;text-decoration:none;border-radius:999px;border:2px solid var(--green);text-align:center}
.rcard-body p{padding-bottom:10px}
.rcard-body .watch:hover{background:var(--green-2);border-color:var(--green-2);text-decoration:none}
.rcard-body .watch:focus-visible{outline:3px solid var(--lime);outline-offset:2px}
@media (prefers-color-scheme: dark){ .rcard-body .watch{background:#2E6B3C;border-color:#2E6B3C;color:#F7F1DE} .rcard-body .watch:hover{background:#3A8149;border-color:#3A8149} }
.reaction-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:10px}
.reaction-dots{display:flex;gap:7px}
.reaction-dots button{width:8px;height:8px;min-height:0;padding:0;border:none;border-radius:999px;background:var(--line);cursor:pointer;transition:width .2s ease,background .2s ease}
.reaction-dots button[aria-current="true"]{width:26px;background:var(--persimmon)}
.reaction-hint{color:var(--ink-soft);font-size:13.5px;margin:0}
@media (max-width:640px){ .reaction-controls{display:none} .rcard{flex-basis:min(62vw,220px)} .rcard-body{padding:10px 12px 12px} .rcard-body h3{font-size:15px} .rcard-body p{font-size:12.5px} .reaction-foot{justify-content:center} .reaction-hint{display:none} }

/* signature highlights — same horizontal swipe row as reactions, tappable food cards */
.sigcard{scroll-snap-align:start;flex:0 0 min(88vw,500px);height:190px;display:flex;flex-direction:row;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;color:var(--ink);box-shadow:0 8px 22px rgba(23,48,29,.07);padding:0;margin:0;font:inherit;text-align:left;cursor:pointer}
.sigcard-thumb{position:relative;flex:none;width:42%;display:block}
.sigcard-thumb img{width:100%;height:100%;object-fit:cover}
.sigcard-price{position:absolute;left:10px;bottom:10px;background:var(--lime);color:#123B1E;font-weight:700;font-size:13.5px;padding:7px 11px;border-radius:999px;white-space:nowrap;box-shadow:0 4px 12px rgba(0,0,0,.22)}
.sigcard-body{padding:16px 18px;display:flex;flex-direction:column;gap:3px;flex:1;min-width:0}
.sigcard-badge{align-self:flex-start;background:var(--badge-red);color:#FFF7EA;font-family:"Oswald",sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;padding:4px 10px;border-radius:999px;margin-bottom:5px}
.sigcard-label{color:var(--persimmon);font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:5px}
.sigcard-body h3{font-size:18.5px;line-height:1.18;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.sigcard-body p{margin:2px 0 0;color:var(--ink-soft);font-size:14.5px;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.sigcard-body .view{font-family:"Oswald",sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--green-2);margin-top:auto;padding-top:8px}
@media (max-width:640px){ .sigcard{height:176px} .sigcard-thumb{width:38%} .sigcard-body{padding:13px 14px} .sigcard-body h3{font-size:16.5px} .sigcard-body p{font-size:13.5px} }

/* video band */
.video-band{position:relative;overflow:hidden;background:var(--green-deep)}
.video-band video{width:100%;height:min(72vh,560px);object-fit:cover;opacity:.92}
.video-band .overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;background:linear-gradient(rgba(9,28,14,.18),rgba(9,28,14,.45))}
.video-band h2{color:#FFF9E8;font-size:clamp(36px,6vw,72px);font-weight:700;text-shadow:0 2px 22px rgba(0,0,0,.35)}
.video-band p{color:#EDEBD2;font-size:18px;margin:14px 0 24px;max-width:34em;text-shadow:0 1px 10px rgba(0,0,0,.4)}

/* story */
.story-state{font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;text-align:center;font-size:clamp(27px,3.8vw,44px);line-height:1.32;max-width:22em;margin:0 auto}
.story-state em{font-style:normal;color:var(--green-2)}
.story-copy{max-width:42em;margin:26px auto 0;text-align:center;color:var(--ink-soft);font-size:20.5px;line-height:1.7}
.story-copy strong{color:var(--ink)}
.story-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:40px}
.story-photos figure{margin:0}
.story-photos img{border-radius:10px;width:100%;aspect-ratio:4/3;object-fit:cover}
.story-photos figcaption{font-size:13.5px;color:var(--ink-soft);margin-top:8px}
.values{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:44px}
.value{border-top:3px solid var(--green);padding-top:16px}
.value h3{font-size:22px}
.value p{color:var(--ink-soft);font-size:17.5px;margin:6px 0 0}

/* visit */
.visit{background:var(--green);color:var(--cream-on-dark)}
@media (prefers-color-scheme: dark){ .visit{background:#1E3A24} }
.visit-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.visit h2{font-size:clamp(34px,4.4vw,54px);font-weight:700;color:#FFF9E8}
.visit .kicker{color:var(--lime);font-family:"Oswald",sans-serif;font-size:13px;letter-spacing:.3em;text-transform:uppercase;font-weight:600;margin:0 0 12px}
.visit address{font-style:normal;font-size:19px;line-height:1.55;margin-top:18px}
.visit a{color:#FFF9E8}
.visit .muted{color:#C9D6B8;font-size:15.5px}
.hours-head{font-size:21px;color:#FFF9E8;margin-top:26px}
.today-hours{display:inline-block;margin-top:12px;background:rgba(156,207,95,.16);border:1px solid rgba(156,207,95,.55);color:var(--lime);font-weight:700;font-size:16.5px;padding:7px 14px;border-radius:999px}
.hours{width:100%;border-collapse:collapse;font-size:16.5px;margin-top:10px}
.hours td{padding:8px 4px;border-bottom:1px solid rgba(247,241,222,.18)}
.hours tr:last-child td{border-bottom:none}
.hours td:last-child{text-align:right;font-weight:500;white-space:nowrap}
.hours tr.today td{color:var(--lime);font-weight:700}
.visit-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.visit-photo{margin:0}
.visit-photo img{border-radius:10px;width:100%;height:100%;min-height:340px;object-fit:cover}
.visit-photo figcaption{font-size:13.5px;color:#C9D6B8;margin-top:10px}

/* footer */
footer.site{background:var(--green-deep);color:#C9D6B8;padding:52px 0 30px}
@media (prefers-color-scheme: dark){ footer.site{background:#0C1A0E} }
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px}
footer.site .name{font-family:"Oswald",sans-serif;font-weight:700;font-size:28px;letter-spacing:.28em;color:#FFF9E8}
footer.site h4{font-family:"Oswald",sans-serif;font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:var(--lime);margin:0 0 12px;font-weight:600}
footer.site p,footer.site a{font-size:15.5px}
footer.site a{color:#F7F1DE;text-decoration:none}
footer.site a:hover{text-decoration:underline}
.foot-bottom{border-top:1px solid rgba(247,241,222,.16);margin-top:34px;padding-top:18px;font-size:13.5px;color:#93A87F;display:flex;flex-wrap:wrap;gap:8px 24px;justify-content:space-between}

/* ---------- responsive ---------- */
@media (max-width:1020px){
  .menu-grid{grid-template-columns:repeat(4,1fr)}
  .reels{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:860px){
  /* Header stays stacked at every width: big centered SODAM wordmark on
     top, then one no-wrap row of controls — Instagram, Call, Search,
     Sign in, Order, and the three-bar quick menu pinned to the far right —
     so nothing is ever pushed off the right edge. */
  .wordmark .sub{font-size:12px;letter-spacing:.36em}
  .header-actions{gap:8px}
  .hero-in{grid-template-columns:1fr;padding:32px 0 44px;gap:30px}
  .hero-photo img{max-height:400px}
  .menu-grid{grid-template-columns:repeat(3,1fr)}
  .visit-grid{grid-template-columns:1fr;gap:32px}
  .foot-grid{grid-template-columns:1fr}
  .drink-list{grid-template-columns:1fr}
  .values{grid-template-columns:1fr;gap:20px}
  .story-photos{grid-template-columns:1fr}
  .phone-link .num{display:none}
  header.site .header-in{position:relative}
}
@media (max-width:640px){
  .menu-grid{grid-template-columns:repeat(2,1fr);gap:20px 12px}
  .menu-card h3{font-size:16.5px;min-height:2.4em}
  .menu-card p{font-size:13px;line-height:1.4}
  .menu-card .price{font-size:16px}
  .menu-card .add-btn{width:100%;padding:11px 8px;font-size:13.5px;letter-spacing:.04em}
  .menu-card .viewhint{font-size:11px;letter-spacing:.06em}
  .menu-card .fav-star{width:40px;height:40px;min-height:40px;top:6px;left:6px}
}
@media (max-width:520px){
  .menu-grid{grid-template-columns:repeat(2,1fr)}
  .reels{grid-template-columns:1fr}
  .wordmark .sub{font-size:11.5px;letter-spacing:.34em}
  header.site .wrap{padding:10px 14px 0}
  .header-actions{gap:5px}
  .header-actions .cart-btn{padding:9px 11px;font-size:13.5px;gap:5px}
  .header-actions .phone-link{padding:10px 2px}
  .header-actions .btn{padding:10px 14px;font-size:13.5px}
  section.block{padding:52px 0}
  .video-band video{height:420px}
}


/* ---------- pickup ordering (merged) ---------- */
.cart-btn{position:relative;display:inline-flex;align-items:center;gap:8px;background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:10px 16px;font-family:"Oswald",sans-serif;font-weight:600;font-size:14px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:44px;white-space:nowrap}
.cart-btn:hover{background:var(--persimmon-deep)}
.cart-count{background:#FFF7EA;color:var(--persimmon-deep);border-radius:999px;min-width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;font-size:13.5px;padding:0 6px}
.menu-card .add-btn{margin-top:10px;align-self:center;background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:11px 22px;font-family:"Oswald",sans-serif;font-weight:600;font-size:14.5px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:48px;box-shadow:0 6px 16px rgba(200,80,31,.28);white-space:nowrap}
.menu-card .add-btn:hover{background:var(--persimmon-deep)}
.menu-card .add-btn:active{transform:scale(.97)}
.modal-addrow{display:flex;gap:12px;align-items:stretch;margin-top:18px;flex-wrap:wrap}
.add-to-order{flex:1;min-width:210px;background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:14px 22px;font-family:"Oswald",sans-serif;font-weight:600;font-size:16.5px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:52px}
.add-to-order:hover{background:var(--persimmon-deep)}
.field-label{font-family:"Oswald",sans-serif;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-soft);display:block;margin:20px 0 8px}
.modal select,.modal input[type="text"],.modal input[type="tel"],.cart-modal select,.cart-modal input{width:100%;border:1.5px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font-family:inherit;font-size:16.5px;padding:12px;min-height:50px}
.added-toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(178px + env(safe-area-inset-bottom,0px));z-index:620;background:var(--green);color:#F7F1DE;padding:12px 22px;border-radius:999px;font-family:"Oswald",sans-serif;font-weight:600;letter-spacing:.05em;text-transform:uppercase;font-size:14.5px;box-shadow:var(--shadow);display:none;pointer-events:none}
.added-toast.show{display:block}
/* View-order bar sits well above the phone's bottom edge / app tab bar, so a tap on it always lands on this button inside the page — never on the host app's navigation below the page. */
.float-cart{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(92px + env(safe-area-inset-bottom,0px));z-index:590;width:min(560px,calc(100vw - 28px));display:none;pointer-events:none}
.float-cart.show{display:block}
.float-cart button{width:100%;background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:16px 22px;font-family:"Oswald",sans-serif;font-weight:600;font-size:16.5px;letter-spacing:.05em;text-transform:uppercase;display:flex;justify-content:space-between;gap:12px;cursor:pointer;box-shadow:0 14px 34px rgba(12,26,14,.35);pointer-events:auto;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.cart-line{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:14px 16px;margin-top:12px}
.cart-line-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.cart-line-head strong{font-size:16.5px;line-height:1.35}
.cart-line .opts{color:var(--ink-soft);font-size:14px;margin-top:3px}
.cart-line .note{color:var(--persimmon-deep);font-size:14px;font-weight:500;margin-top:3px}
.cart-line-foot{display:flex;align-items:center;gap:10px;margin-top:10px}
.remove-line{margin-left:auto;background:none;border:none;color:var(--persimmon-deep);text-decoration:underline;font:inherit;font-size:14.5px;cursor:pointer;padding:8px}
.form-error{background:#FDECE4;color:#7A2A0C;border:1px solid #E8A183;border-radius:10px;padding:11px 14px;font-size:15px;margin-top:14px}
@media (prefers-color-scheme: dark){ .form-error{background:#3A1E12;color:#F5C4A8;border-color:#7A3B1E} }
.total-row{display:flex;justify-content:space-between;align-items:baseline;margin-top:20px;border-top:1px solid var(--line);padding-top:16px}
.total-row .amt{font-family:"Oswald",sans-serif;font-size:26px;font-weight:700;color:var(--persimmon)}
.place-btn{width:100%;margin-top:14px;background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:15px 22px;font-family:"Oswald",sans-serif;font-weight:600;font-size:17px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:54px}
.place-btn:hover{background:var(--persimmon-deep)}
.place-btn:disabled{opacity:.5;cursor:default}
/* Place Pickup Order sits well above the phone's bottom edge / app tab bar, same fix as the View Order bar: the checkout sheet is flush with the bottom of the screen, so give the sheet enough bottom padding that the button's tap target ends ~104px above the edge (plus the device safe area) and a tap always lands on this button inside the page — never on the host app's navigation below the page. Bottom-sheet layout only; on wider screens the dialog is centered and unchanged. */
#placeOrder{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
@media (max-width:699px){ #cartModal .modal{padding-bottom:calc(104px + env(safe-area-inset-bottom,0px))} }
.confirm-box{border:2px solid var(--persimmon);background:var(--card);border-radius:16px;padding:26px;margin-top:8px}
.confirm-box h3{font-size:28px}
.status-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:20px;list-style:none;padding:0}
.status-steps li{text-align:center;font-size:13px;color:var(--ink-soft)}
.status-steps li::before{content:"";display:block;height:10px;border-radius:99px;background:var(--line);margin-bottom:8px}
.status-steps li.done{color:var(--ink);font-weight:600}
.status-steps li.done::before{background:var(--persimmon)}
.staff-sec{background:var(--sand-2);border-top:1px solid var(--line)}
.staff-tools{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:18px 0}
.staff-tools .counts{color:var(--ink-soft);font-size:15px;margin-right:auto}
.pill-btn{border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:9px 16px;font-family:"Oswald",sans-serif;font-weight:600;font-size:13.5px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:44px}
.pill-btn[aria-pressed="true"],.pill-btn[aria-selected="true"]{background:var(--green);color:#F7F1DE;border-color:var(--green)}
@media (prefers-color-scheme: dark){ .pill-btn[aria-pressed="true"],.pill-btn[aria-selected="true"]{background:#2E6B3C} }
.new-alert{background:var(--persimmon);color:#FFF7EA;border-radius:14px;padding:16px 18px;display:none;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:20px}
.new-alert.show{display:flex}
.new-alert strong{font-family:"Oswald",sans-serif;text-transform:uppercase;letter-spacing:.06em;font-size:18px}
.new-alert button{background:#FFF7EA;color:#7A2A0C;border:none;border-radius:999px;padding:10px 18px;font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;font-size:13.5px;cursor:pointer;min-height:44px}
.order-card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-top:14px}
.order-card.fresh{border:2px solid var(--persimmon)}
.order-card h4{font-size:22px;margin:0}
.order-card .pickup-chip{background:var(--persimmon);color:#FFF7EA;border-radius:999px;padding:5px 12px;font-weight:700;font-size:14px;white-space:nowrap}
.order-card ul{margin:12px 0 0;padding:12px 0 0 18px;border-top:1px solid var(--line)}
.order-card li{margin-top:5px}
.order-card .o-opts{display:block;color:var(--ink-soft);font-size:14px;padding-left:4px}
.order-card .o-note{display:block;color:var(--persimmon-deep);font-size:14px;font-weight:500}
.staff-group-head{font-family:"Oswald",sans-serif;font-size:15px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);margin:30px 0 2px}
.global-alert{position:fixed;top:0;left:0;right:0;z-index:400;background:var(--persimmon);color:#FFF7EA;padding:14px 18px;display:none;align-items:center;gap:14px;flex-wrap:wrap;box-shadow:0 10px 28px rgba(12,26,14,.35)}
.global-alert.show{display:flex}
.global-alert button{background:#FFF7EA;color:#7A2A0C;border:none;border-radius:999px;padding:9px 16px;font-family:"Oswald",sans-serif;font-weight:600;text-transform:uppercase;font-size:13px;cursor:pointer;min-height:40px}
.staff-locked{background:var(--card);border:2px dashed var(--line);border-radius:16px;padding:36px 26px;text-align:center}
.staff-locked .lock-ic{width:58px;height:58px;border-radius:50%;background:var(--green);color:#F7F1DE;display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px}
@media (prefers-color-scheme: dark){ .staff-locked .lock-ic{background:#2E6B3C} }
.staff-locked h3{font-size:24px}
.staff-locked p{color:var(--ink-soft);max-width:38em;margin:10px auto 0;font-size:16px}
.staff-badge{display:inline-block;background:var(--green);color:#F7F1DE;font-family:"Oswald",sans-serif;font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:6px 13px;border-radius:999px;margin-bottom:12px}
@media (prefers-color-scheme: dark){ .staff-badge{background:#2E6B3C} }
.staff-test-note{background:#FFF3D6;border:1px solid #E3C46A;color:#5C4300;border-radius:10px;padding:12px 14px;font-size:15px;margin-top:16px;line-height:1.5}
.staff-test-note strong{font-family:"Oswald",sans-serif;letter-spacing:.04em;text-transform:uppercase;font-size:13.5px}
@media (prefers-color-scheme: dark){ .staff-test-note{background:#3A2E08;color:#F5D98A;border-color:#7A5E14} }
.staff-signout-btn{border-color:var(--persimmon);color:var(--persimmon-deep)}
.modal input[type="password"]{width:100%;border:1.5px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font-family:inherit;font-size:16.5px;padding:12px;min-height:50px}

/* ---------- regulars: sign-in + repeat order ---------- */
.account-btn{display:inline-flex;align-items:center;gap:7px;background:transparent;color:var(--green);border:1.5px solid var(--green);border-radius:999px;padding:9px 15px;font-family:"Oswald",sans-serif;font-weight:600;font-size:14px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:44px;white-space:nowrap;max-width:190px}
.account-btn:hover{background:var(--green);color:#F7F1DE}
.account-btn .a-label{overflow:hidden;text-overflow:ellipsis}
.account-btn svg{flex:none}
@media (prefers-color-scheme: dark){ .account-btn{color:var(--ink);border-color:var(--ink)} .account-btn:hover{background:var(--ink);color:#141B12} }
@media (max-width:700px){ .account-btn{width:44px;height:44px;padding:0;justify-content:center} .account-btn .a-label{display:none} }
.regulars-cta{display:flex;flex-wrap:wrap;gap:14px 20px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 22px}
.regulars-cta p{margin:0;flex:1;min-width:min(100%,300px);color:var(--ink-soft);font-size:16px}
.regulars-cta p strong{color:var(--ink)}
.signin-btn{background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:13px 24px;font-family:"Oswald",sans-serif;font-weight:600;font-size:15px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:50px;flex:none}
.signin-btn:hover{background:var(--persimmon-deep)}
.device-note{color:var(--ink-soft);font-size:14px;margin:14px 2px 0}
.signedin-bar{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 20px;margin-bottom:16px}
.signedin-bar .who{font-size:16.5px;margin:0;flex:1;min-width:min(100%,240px)}
.signedin-bar .who strong{font-family:"Oswald",sans-serif;text-transform:uppercase;letter-spacing:.04em}
.signout-btn{background:none;border:1.5px solid var(--line);color:var(--ink);border-radius:999px;padding:9px 18px;font-family:"Oswald",sans-serif;font-weight:600;font-size:13.5px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:44px}
.signout-btn:hover{border-color:var(--persimmon);color:var(--persimmon-deep)}
.hist-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media (max-width:760px){ .hist-grid{grid-template-columns:1fr} }
.hist-card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column}
.hist-card .h-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}
.hist-card h4{font-size:20px;margin:0}
.hist-card .h-when{color:var(--ink-soft);font-size:14px;margin:3px 0 0}
.hist-card ul{margin:12px 0 0;padding:12px 0 0 18px;border-top:1px solid var(--line)}
.hist-card li{margin-top:5px}
.hist-card .o-opts{display:block;color:var(--ink-soft);font-size:14px;padding-left:4px}
.hist-card .o-note{display:block;color:var(--persimmon-deep);font-size:14px;font-weight:500}
.hist-card .h-foot{display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:16px}
.hist-card .h-total{font-family:"Oswald",sans-serif;font-size:20px;font-weight:700;color:var(--persimmon)}
.repeat-btn{margin-left:auto;background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:12px 22px;font-family:"Oswald",sans-serif;font-weight:600;font-size:14.5px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:48px}
.repeat-btn:hover{background:var(--persimmon-deep)}
.repeat-btn:active{transform:scale(.97)}
.cart-account-note{background:var(--sand-2);border:1px solid var(--line);border-radius:10px;padding:11px 14px;font-size:15px;margin-top:14px;color:var(--ink-soft)}
.cart-account-note strong{color:var(--ink)}
.cart-account-note button{background:none;border:none;color:var(--persimmon-deep);text-decoration:underline;font:inherit;font-weight:600;cursor:pointer;padding:2px}

/* favorites: star on each menu card + My Favorites tab */
.menu-card{position:relative}
.fav-star{position:absolute;top:8px;left:8px;z-index:3;width:42px;height:42px;min-height:42px;border-radius:50%;border:1.5px solid var(--line);background:var(--card);color:#B9AC87;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 12px rgba(23,48,29,.14);padding:0}
.fav-star svg path{fill:none}
.fav-star:hover{border-color:#D9A419;color:#D9A419}
.fav-star.on{background:#FDEFC0;border-color:#D9A419;color:#8A5A00}
.fav-star.on svg path{fill:#F7B500;stroke:#8A5A00}
@media (prefers-color-scheme: dark){ .fav-star.on{background:#4A3A08} }
.fav-star:active{transform:scale(.94)}
.menu-tabs button.fav-tab{color:var(--persimmon-deep)}
.menu-tabs button.fav-tab[aria-selected="true"]{color:var(--ink)}
.fav-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
@media (max-width:760px){ .fav-list{grid-template-columns:1fr} }
.fav-row{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.fav-row img{width:52px;height:52px;border-radius:9px;object-fit:cover;flex:none}
.fav-row .f-info{flex:1;min-width:0}
.fav-row .f-info strong{display:block;font-size:15.5px;line-height:1.3}
.fav-row .f-info span{color:var(--persimmon);font-weight:700;font-size:14.5px}
.fav-row .f-add{background:var(--persimmon);color:#FFF7EA;border:none;border-radius:999px;padding:10px 16px;font-family:"Oswald",sans-serif;font-weight:600;font-size:13px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;min-height:44px;flex:none}
.fav-row .f-add:hover{background:var(--persimmon-deep)}
.fav-row .f-remove{background:none;border:none;color:#D9A419;cursor:pointer;padding:8px;flex:none;display:flex}
.fav-empty{grid-column:1/-1;text-align:center;color:var(--ink-soft);padding:26px 14px;font-size:16.5px;background:var(--card);border:1px dashed var(--line);border-radius:12px}
.subhead-reg{font-family:"Oswald",sans-serif;font-size:19px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin:22px 0 2px}

/* ---------- quick-scroll bar (right edge) ---------- */
.qscroll{position:fixed;top:calc(var(--header-h,97px) + 6px);bottom:0;right:0;width:30px;z-index:150;touch-action:none;cursor:pointer;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
.qscroll-track{position:absolute;top:10px;bottom:10px;right:5px;width:9px;border-radius:99px;background:rgba(18,59,30,.22);box-shadow:inset 0 0 0 1px rgba(18,59,30,.10)}
.qscroll-thumb{position:absolute;right:1.5px;width:17px;min-height:52px;border-radius:99px;background:var(--green);border:2px solid rgba(255,253,246,.85);box-shadow:0 2px 8px rgba(12,26,14,.4);display:flex;align-items:center;justify-content:center;transition:width .15s ease,right .15s ease}
.qscroll-thumb::before{content:"";width:7px;height:22px;background-image:repeating-linear-gradient(to bottom,rgba(247,241,222,.9) 0 2px,transparent 2px 7px)}
.qscroll:hover .qscroll-thumb,.qscroll.dragging .qscroll-thumb,.qscroll:focus-visible .qscroll-thumb{width:21px;right:.5px}
.qscroll:focus-visible{outline:2px solid var(--persimmon);outline-offset:-2px}
@media (prefers-color-scheme: dark){
  .qscroll-track{background:rgba(240,234,210,.22);box-shadow:inset 0 0 0 1px rgba(240,234,210,.12)}
  .qscroll-thumb{border-color:rgba(20,27,18,.7)}
  .qscroll-thumb::before{background-image:repeating-linear-gradient(to bottom,rgba(20,27,18,.75) 0 2px,transparent 2px 7px)}
}
</style>
<style>
/* Server replica: show the whole photo inside the same-size frame, never cropped (Frank's fix). */
.menu-card .photo img{object-fit:contain !important;background:#fff}
.sigcard-thumb img{object-fit:contain !important;background:#fff}
.badge-oos{background:#8a8a8a !important}
</style>
<style>
/* ---------- Framer-style motion pass + logo 12 (port of the approved test copy) ---------- */
:root{--gold:#D99A16}
/* 1. Scroll-reveal: elements are visible by default. JS adds
   .reveal-pending immediately before observing, then .reveal-visible
   when they enter the viewport. Transform + opacity only. */
.reveal-pending{opacity:0;transform:translateY(36px);transition:opacity .8s ease-out,transform .8s ease-out;transition-delay:var(--reveal-delay,0ms);will-change:opacity,transform}
.reveal-visible{opacity:1;transform:translateY(0)}
/* 2. Hero entrance */
@keyframes hero-line-in{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes hero-photo-in{from{transform:scale(1.06)}to{transform:scale(1)}}
@keyframes hero-fade-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.hero-line{display:block;animation:hero-line-in .7s ease-out both}
.hero-line-1{animation-delay:0ms}
.hero-line-2{animation-delay:180ms}
.hero-line-3{animation-delay:360ms}
.hero-photo-img{animation:hero-photo-in 1.6s cubic-bezier(.22,1,.36,1) both;will-change:transform}
.hero .lede{animation:hero-fade-in .7s ease-out both;animation-delay:560ms}
.hero-ctas{animation:hero-fade-in .7s ease-out both;animation-delay:680ms}
.hero-meta{animation:hero-fade-in .7s ease-out both;animation-delay:800ms}
/* Hero / Visit photo frames: clip the parallax + Ken Burns drift */
.hero-photo-frame{overflow:hidden;border-radius:10px;box-shadow:var(--shadow)}
.hero-photo-frame img{border-radius:0;box-shadow:none}
.visit-photo-frame{overflow:hidden;border-radius:10px;height:100%}
.visit-photo-frame .parallax-img{height:100%}
.visit-photo-frame img{border-radius:0}
/* 3. Item detail sheet transition (item modal only) */
#itemModal{transition:background-color .35s ease-out}
#itemModal.open{background-color:rgba(12,26,14,0)}
#itemModal.open.sheet-in{background-color:rgba(12,26,14,.62)}
#itemModal .modal{transition:opacity .35s ease-out,transform .35s ease-out;will-change:opacity,transform}
#itemModal.open .modal{opacity:0;transform:translateY(44px)}
#itemModal.open.sheet-in .modal{opacity:1;transform:translateY(0)}
/* 4. Card hover / press: lift uses the independent translate/scale
   properties so it composes with the scroll-reveal transform instead
   of fighting it. */
.polish-card{transition:translate .28s ease,scale .28s ease,box-shadow .28s ease;-webkit-tap-highlight-color:transparent}
.reveal-pending.polish-card,.reveal-visible.polish-card{transition:opacity .8s ease-out,transform .8s ease-out,translate .28s ease,scale .28s ease,box-shadow .28s ease;transition-delay:var(--reveal-delay,0ms),var(--reveal-delay,0ms),0ms,0ms,0ms}
.menu-card .photo img,.sigcard-thumb img{transition:transform .3s ease}
.sigcard-thumb{overflow:hidden}
@media (hover:hover) and (pointer:fine){
  .polish-card:hover{translate:0 -2px;box-shadow:0 12px 28px rgba(23,48,29,.14),0 2px 6px rgba(23,48,29,.08)}
  .menu-card.polish-card:hover .photo img{transform:scale(1.04)}
  .sigcard.polish-card:hover .sigcard-thumb img{transform:scale(1.04)}
}
.polish-card:active{scale:.98}
/* 5a. Favourite star pop */
@keyframes star-pop-kf{0%{transform:scale(1)}40%{transform:scale(1.35)}100%{transform:scale(1)}}
.pop-star{animation:star-pop-kf .3s ease}
/* 5b. Cart / order count bump */
@keyframes cart-bump-kf{0%{transform:scale(1)}35%{transform:scale(1.13)}100%{transform:scale(1)}}
.cart-bump{animation:cart-bump-kf .32s ease}
/* 5c. Added toast slide-and-fade */
@keyframes toast-in-kf{from{opacity:0;transform:translateX(-50%) translateY(14px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
.added-toast{transition:opacity .25s ease,transform .25s ease}
.added-toast.show{animation:toast-in-kf .32s ease-out both}
.added-toast.toast-leaving{opacity:0;transform:translateX(-50%) translateY(8px);animation:none}
/* 7. Light parallax: JS drives the independent translate property via
   rAF; the slight scale keeps the drifting photo inside its clipped
   frame so no edge ever shows. */
.parallax-img{scale:1.07;will-change:translate}
/* 8. Header entrance on load: logo card settles first, the button row
   a beat later. CSS-only, one-time; the header itself is a normal
   non-sticky header that scrolls away with the page. */
@keyframes header-settle{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:translateY(0)}}
.header-enter-word{animation:header-settle .6s ease-out both}
.header-enter-buttons{animation:header-settle .6s ease-out .18s both}
/* 9. Logo 12, boxless: original colours on the light (sand) header,
   cream reversed artwork on the dark header, swapped by colour scheme
   — no card behind it in either mode. Gold sheen sweep across the
   logo: once ~1s after load (after the header entrance), never loops.
   The sheen layer is masked by the logo artwork's own alpha (the same
   PNG, per colour scheme), so the band shines on the artwork itself
   only — never in the transparent gaps around the letters. Tap/click
   on the logo replays it once (JS adds .sheen-replay). The
   band is brightened so it reads over the full-colour artwork too. */
.logo-card{display:block;background:none;border:none;border-radius:0;padding:0;box-shadow:none;position:relative;overflow:hidden;line-height:0}
.logo-card img{height:clamp(139.3px,28vw,194.6px);width:auto;max-width:88vw;object-fit:contain;filter:none}
.logo-card .logo-dark{display:none}
@media (prefers-color-scheme: dark){
  .logo-card .logo-light{display:none}
  .logo-card .logo-dark{display:block}
  .logo-card .logo-sheen{-webkit-mask-image:url("data:image/png;base64,");mask-image:url("data:image/png;base64,")}
}
.logo-sheen{position:absolute;inset:0;pointer-events:none;-webkit-mask-image:url("data:image/png;base64,");mask-image:url("data:image/png;base64,");-webkit-mask-size:contain;mask-size:contain;-webkit-mask-position:center;mask-position:center;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
.logo-sheen-band{display:block;position:absolute;inset:0;background:linear-gradient(100deg,rgba(255,237,176,0) 32%,rgba(217,154,22,.24) 44%,rgba(255,240,190,.85) 50%,rgba(217,154,22,.24) 56%,rgba(255,237,176,0) 68%);transform:translateX(-130%);animation:logo-sheen 1.8s ease-in-out 1s both}
@keyframes logo-sheen{from{transform:translateX(-130%)}to{transform:translateX(130%)}}
.logo-card.sheen-replay .logo-sheen-band{animation:logo-sheen 1.8s ease-in-out both}
/* 10. Header button micro-motion: gentle press on tap/click, a very
   subtle lift + brighten on desktop hover. The Instagram button's
   gradient icon is untouched. */
.header-actions .ig-link,.header-actions .phone-link,.header-actions .search-toggle,.header-actions .account-btn,.header-actions .cart-btn,.header-actions .burger{transition:transform .15s ease,filter .15s ease}
.header-actions .ig-link:active,.header-actions .phone-link:active,.header-actions .search-toggle:active,.header-actions .account-btn:active,.header-actions .cart-btn:active,.header-actions .burger:active{transform:scale(.95)}
@media (hover:hover) and (pointer:fine){
  .header-actions .ig-link:hover,.header-actions .phone-link:hover,.header-actions .search-toggle:hover,.header-actions .account-btn:hover,.header-actions .cart-btn:hover,.header-actions .burger:hover{transform:translateY(-1px);filter:brightness(1.06)}
  .header-actions .ig-link:active,.header-actions .phone-link:active,.header-actions .search-toggle:active,.header-actions .account-btn:active,.header-actions .cart-btn:active,.header-actions .burger:active{transform:scale(.95)}
}
/* 11. Slow Ken Burns drift on the hero photo. Layering, so the three
   hero effects never share a property on the same element:
   - wrapper div: hero entrance (animation on transform) + parallax
     (JS-driven independent translate, CSS scale 1.07)
   - the img itself: this Ken Burns loop (transform on the img) */
.kenburns-img{animation:kenburns-drift 22s ease-in-out infinite alternate;will-change:transform}
@keyframes kenburns-drift{from{transform:scale(1) translate(0,0)}to{transform:scale(1.06) translate(-8px,-5px)}}
@media (prefers-reduced-motion: reduce){
  .reveal-pending{opacity:1 !important;transform:none !important;transition:none !important}
  .reveal-visible{opacity:1 !important;transform:none !important}
  .hero-line,.hero-photo-img,.hero .lede,.hero-ctas,.hero-meta{animation:none !important}
  #itemModal,#itemModal .modal{transition:none !important}
  .polish-card,.menu-card .photo img,.sigcard-thumb img{transition:none !important}
  .polish-card:hover,.polish-card:active{translate:none !important;scale:none !important;box-shadow:none !important}
  .menu-card.polish-card:hover .photo img,.sigcard.polish-card:hover .sigcard-thumb img{transform:none !important}
  .pop-star,.cart-bump{animation:none !important}
  .added-toast{animation:none !important;transition:none !important}
  .parallax-img{scale:none !important;translate:none !important}
  .header-enter-word,.header-enter-buttons,.kenburns-img{animation:none !important}
  .logo-sheen-band{animation:none !important}
  .header-actions .ig-link,.header-actions .phone-link,.header-actions .search-toggle,.header-actions .account-btn,.header-actions .cart-btn,.header-actions .burger{transition:none !important}
  .header-actions .ig-link:hover,.header-actions .phone-link:hover,.header-actions .search-toggle:hover,.header-actions .account-btn:hover,.header-actions .cart-btn:hover,.header-actions .burger:hover,.header-actions .ig-link:active,.header-actions .phone-link:active,.header-actions .search-toggle:active,.header-actions .account-btn:active,.header-actions .cart-btn:active,.header-actions .burger:active{transform:none !important;filter:none !important}
}

</style>
<style>
/* Bestseller badge lives within the photo, upper-right corner (2026-11-17) */
.badge-photo{position:absolute;top:8px;right:8px;z-index:3;margin:0;align-self:auto;box-shadow:0 4px 12px rgba(23,48,29,.20)}
.sigcard-thumb .sigcard-badge{position:absolute;top:8px;right:8px;z-index:2;margin:0;align-self:auto;box-shadow:0 4px 12px rgba(23,48,29,.20)}
.modal-photo-wrap{position:relative}
#modalBadge{position:absolute;top:12px;right:12px;z-index:2;margin:0}
</style>
<style>
/* Photo frames: the ratio lives on the frame, not the img (2026-11-17) —
   every photo box in a row is sized by its column alone, so landscape
   grids stay aligned at any width; the img fills the frame and keeps
   object-fit: contain, so nothing is stretched or cropped. */
.menu-card .photo{aspect-ratio:4/3}
.menu-card .photo img{position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto}
.modal-photo-wrap{aspect-ratio:16/10}
.modal-photo{position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto}
</style>
</head>
<body>
<div class="ticker" aria-hidden="true">
  <div class="ticker-track" id="tickerTrack">
    <span>Fresh Poke <i>✳</i></span><span>Okinawa Onigiri <i>✳</i></span><span>Onigirazu <i>✳</i></span><span>Poke Nachos <i>✳</i></span><span>Matcha Strawberry <i>✳</i></span><span>Handcrafted Boba <i>✳</i></span>
  </div>
</div>

<header class="site">
  <div class="wrap header-in">
    <nav class="main" id="mainNav" aria-label="Main">
      <a href="#menu">Menu</a>
      <a href="#regulars">Regulars</a>
      <a href="#story">Our Story</a>
      <a href="#visit">Visit / Hours</a>
      <a href="#staff" id="staffNavLink">Staff Board — Staff Sign-In</a>
    </nav>
    <a class="wordmark logo-card header-enter-word" href="#top" id="logoCard" aria-label="Sodam Boba and Poke Cafe — home">
      <img class="logo-light" src="data:image/png;base64," alt="SODAM Boba &amp; Poke Cafe" width="1458" height="1100" />
      <img class="logo-dark" src="data:image/png;base64," alt="" aria-hidden="true" width="1458" height="1100" />
      <span class="logo-sheen" aria-hidden="true"><span class="logo-sheen-band"></span></span>
    </a>
    <div class="header-actions header-enter-buttons">
      <a class="ig-link" href="https://www.instagram.com/sodamcafe_/" target="_blank" rel="noopener" aria-label="Follow Sodam Boba and Poke Cafe on Instagram — @sodamcafe_">
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><defs><linearGradient id="igGradient" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#FEDA75"/><stop offset="30%" stop-color="#FA7E1E"/><stop offset="55%" stop-color="#D62976"/><stop offset="80%" stop-color="#962FBF"/><stop offset="100%" stop-color="#4F5BD5"/></linearGradient></defs><rect x="0" y="0" width="24" height="24" rx="6.5" ry="6.5" fill="url(#igGradient)"/><rect x="5.4" y="5.4" width="13.2" height="13.2" rx="3.8" ry="3.8" fill="none" stroke="#fff" stroke-width="1.9"/><circle cx="12" cy="12" r="3.1" fill="none" stroke="#fff" stroke-width="1.9"/><circle cx="17.15" cy="6.85" r="1.25" fill="#fff"/></svg>
        <span class="ig-text"><span class="ig-follow">Follow us on </span>Instagram</span>
      </a>
      <a class="phone-link" href="tel:+12132473453" aria-label="Call Sodam at (213) 247-3453">
