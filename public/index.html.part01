        <div class="reaction-dots sig-dots" role="tablist" aria-label="Choose a signature item">
          <button type="button" data-sig-dot="0" aria-current="true" aria-label="Show signature item 1 — Spicy Salmon and Tuna Poke Bowl"></button>
          <button type="button" data-sig-dot="1" aria-current="false" aria-label="Show signature item 2 — Citrus Sparkling Ade"></button>
          <button type="button" data-sig-dot="2" aria-current="false" aria-label="Show signature item 3 — Strawberry Cloud"></button>
          <button type="button" data-sig-dot="3" aria-current="false" aria-label="Show signature item 4 — Mango Cloud"></button>
