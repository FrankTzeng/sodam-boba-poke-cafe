","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"];
  function imgPath(i){ return MENU_IMGS[i]; }
  var CUP_SVG = '<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 8h11v6a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8z"/><path d="M16 9h2a2.5 2.5 0 0 1 0 5h-2M8 2v2M12 2v2"/></svg>';

  // Render cards, grouped under Toast subcategory headings
  var grid = document.getElementById('menuGrid');
  var lastSub = null;
  MENU.forEach(function(item, idx){
    if (item.s !== lastSub) {
      lastSub = item.s;
      var head = document.createElement('div');
      head.className = 'menu-subhead';
      head.setAttribute('data-cat', item.c);
      var hh = document.createElement('h3');
      hh.textContent = item.s;
      head.appendChild(hh);
      if (SUB_NOTES[item.s]) {
        var hp = document.createElement('p');
        hp.textContent = SUB_NOTES[item.s];
        head.appendChild(hp);
      }
      grid.appendChild(head);
    }
    var card = document.createElement('article');
    card.className = 'menu-card polish-card';
    card.setAttribute('data-reveal', '');
    card.setAttribute('data-cat', item.c);
    card.setAttribute('data-idx', idx);
    card.setAttribute('tabindex', '0');
    card.setAttribute('role', 'button');
    card.setAttribute('aria-label', item.n + ' — ' + money(item.p) + '. View details.');
    var html = '';
    // Favorite star lives INSIDE the photo (top-left corner of the picture itself),
    // never over the item name, so the full name always stays readable.
    var starHtml = '<button type="button" class="fav-star" data-fav="' + idx + '" aria-pressed="false" aria-label="Save ' + item.n + ' as a favorite — sign in to save favorites"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.8l2.85 5.9 6.45.85-4.7 4.5 1.15 6.4L12 17.35l-5.75 3.1 1.15-6.4-4.7-4.5 6.45-.85z"/></svg></button>';
    var badgeHtml = item.b ? '<span class="badge badge-photo">' + item.b + '</span>' : '';
    if (item.o) html += '<span class="badge badge-oos">OUT OF STOCK</span>';
    html += '<h3>' + item.n + '</h3>';
    if (item.i >= 0) {
      html += '<div class="photo"><img src="' + imgPath(item.i) + '" alt="Sodam\u2019s ' + item.n + ', from its Toast menu" loading="lazy" />' + starHtml + badgeHtml + '</div>';
    } else if (typeof item.r === 'number') {
      html += '<div class="photo"><img src="' + imgPath(item.r) + '" alt="Photo of Sodam\u2019s similar ' + item.rn + ' — Toast has no photo for the ' + item.n + '" loading="lazy" />' + starHtml + badgeHtml + '</div>';
      html += '<p class="sim-note">Photo shows a similar item (' + item.rn + ') — Toast has no photo for this one.</p>';
    } else {
      html += '<div class="photo-none">' + starHtml + CUP_SVG + '<span style="font-size:13px;letter-spacing:.06em">Photo coming soon</span></div>';
    }
    html += '<div class="price">' + money(item.p) + '</div>';
    if (item.d) html += '<p>' + item.d + '</p>';
    html += item.o ? '<button type="button" class="add-btn" disabled aria-label="' + item.n + ' is out of stock">Out of Stock</button>' : '<button type="button" class="add-btn" data-add="' + idx + '" aria-label="Add ' + item.n + ' to your pickup order">\uFF0B Add to Order</button>';
    html += '<span class="viewhint">Tap to view &amp; customize</span>';
    card.innerHTML = html;
    grid.appendChild(card);
  });

  // Menu filter tabs
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.menu-tabs button'));
  var filterables = Array.prototype.slice.call(grid.querySelectorAll('.menu-card, .menu-subhead'));
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(function(t){ t.setAttribute('aria-selected','false'); });
      tab.setAttribute('aria-selected','true');
      var f = tab.getAttribute('data-filter');
      filterables.forEach(function(el){
        var show = (f === 'all' || el.getAttribute('data-cat') === f);
        el.style.display = show ? '' : 'none';
      });
    });
  });

  // ===== Item detail modal (Toast-style) =====
  var modal = document.getElementById('itemModal');
  var modalImg = document.getElementById('modalImg');
  var modalImgNone = document.getElementById('modalImgNone');
  var modalSimNote = document.getElementById('modalSimNote');
  var modalBadge = document.getElementById('modalBadge');
  var modalName = document.getElementById('modalName');
  var modalCat = document.getElementById('modalCat');
  var modalPrice = document.getElementById('modalPrice');
  var modalDesc = document.getElementById('modalDesc');
  var modalCustomize = document.getElementById('modalCustomize');
  var modalGroups = document.getElementById('modalGroups');
  var modalNotes = document.getElementById('modalNotes');
  var qtyOut = document.getElementById('qtyOut');
  var currentItem = null;
  var lastTrigger = null;
  var itemCloseTimer = null;
  var qty = 1;
  function groupsFor(item){
    if (item.k === 'bowl') return [['Poke Bowl toppings', BOWL_TOPPINGS, true], ['Extra toppings', BOWL_TOPPINGS, false]];
    if (item.k === 'oki') return [['Comes With', OKI_PARTS, true]];
    if (item.g) return [['What\u2019s Inside', item.g, true]];
    return [];
  }
  function syncOrder(){
    qtyOut.textContent = qty;
    var ab = document.getElementById('addToOrder');
    if (ab && currentItem) { if (currentItem.o) { ab.disabled = true; ab.textContent = 'Out of Stock'; } else { ab.disabled = false; ab.textContent = 'Add to Order \u00B7 ' + money(currentItem.p * qty); } }
  }
  function openItem(idx, trigger){
    var item = MENU[idx];
    if (!item) return;
    currentItem = item;
    lastTrigger = trigger || null;
    qty = 1;
    modalNotes.value = '';
    if (item.i >= 0) {
      modalImg.src = imgPath(item.i);
      modalImg.alt = 'Sodam\u2019s ' + item.n + ', from its Toast menu';
      modalImg.hidden = false;
      modalImgNone.hidden = true;
      modalSimNote.hidden = true;
      modalSimNote.textContent = '';
    } else if (typeof item.r === 'number') {
      modalImg.src = imgPath(item.r);
      modalImg.alt = 'Photo of Sodam\u2019s similar ' + item.rn + ' — Toast has no photo for the ' + item.n;
      modalImg.hidden = false;
      modalImgNone.hidden = true;
      modalSimNote.textContent = 'Photo shows a similar item (' + item.rn + ') — Toast has no photo for the ' + item.n + '.';
      modalSimNote.hidden = false;
    } else {
      modalImg.hidden = true;
      modalImg.removeAttribute('src');
      modalImgNone.hidden = false;
      modalSimNote.hidden = true;
      modalSimNote.textContent = '';
    }
    modalBadge.hidden = !item.b;
    modalName.textContent = item.n;
    modalCat.textContent = item.s;
    modalPrice.textContent = money(item.p);
    modalDesc.textContent = item.d || '';
    modalDesc.style.display = item.d ? '' : 'none';
    var groups = groupsFor(item);
    modalCustomize.style.display = groups.length ? '' : 'none';
    modalGroups.innerHTML = '';
    groups.forEach(function(gr){
      var wrap = document.createElement('div');
      wrap.className = 'opt-group';
      var title = document.createElement('h5');
      title.textContent = gr[0];
      wrap.appendChild(title);
      var list = document.createElement('div');
      list.className = 'opt-list';
      gr[1].forEach(function(opt){
        var lab = document.createElement('label');
        lab.className = 'opt';
        var box = document.createElement('input');
        box.type = 'checkbox';
        if (gr[2]) box.checked = true;
        var sp = document.createElement('span');
        sp.textContent = opt;
        lab.appendChild(box);
        lab.appendChild(sp);
        list.appendChild(lab);
      });
      wrap.appendChild(list);
      modalGroups.appendChild(wrap);
    });
    var extra = document.getElementById('modalExtra');
    extra.innerHTML = '';
    var kind = '';
    if (item.c === 'drinks' && item.s !== 'Can Soda') kind = (item.s === 'Slushies' || item.s === 'Smoothies' || item.s === 'Milk Tea Blended') ? 'drink-blended' : 'drink-ice';
    else if (item.k === 'bowl' && item.s === 'Bowls') kind = 'bowl-base';
    extra.setAttribute('data-kind', kind);
    function selField(id, label, values, def){
      var lab = document.createElement('label'); lab.className = 'field-label'; lab.setAttribute('for', id); lab.textContent = label; extra.appendChild(lab);
      var s = document.createElement('select'); s.id = id;
      values.forEach(function(v){ var o = document.createElement('option'); o.value = v; o.textContent = v; if (v === def) o.selected = true; s.appendChild(o); });
      extra.appendChild(s);
      return s;
    }
    if (item.f === 'onigiri') selField('exFlavor', 'Filling', CONFIRM_CHOICE, CONFIRM_CHOICE[0]).setAttribute('data-prefix', 'Filling');
    if (item.f === 'blended' || item.f === 'ade') selField('exFlavor', 'Flavor', CONFIRM_CHOICE, CONFIRM_CHOICE[0]).setAttribute('data-prefix', 'Flavor');
    if (kind === 'bowl-base') selField('exBase', 'Base', BOWL_BASES, BOWL_BASES[0]);
    if (kind === 'drink-ice' || kind === 'drink-blended') {
      selField('exSweet', 'Sweetness', SWEETNESS, SWEETNESS[4]);
      if (kind === 'drink-ice') selField('exIce', 'Ice level', ICE_LEVELS, ICE_LEVELS[2]);
      var lab2 = document.createElement('label'); lab2.className = 'field-label'; lab2.textContent = 'Add toppings \u2014 free'; extra.appendChild(lab2);
      var list2 = document.createElement('div'); list2.className = 'opt-list'; list2.id = 'exToppings';
      DRINK_TOPPINGS.forEach(function(tp){
        var l = document.createElement('label'); l.className = 'opt';
        var b = document.createElement('input'); b.type = 'checkbox'; b.value = tp;
        var sp = document.createElement('span'); sp.textContent = tp;
        l.appendChild(b); l.appendChild(sp); list2.appendChild(l);
      });
      extra.appendChild(list2);
    }
    syncOrder();
    if (itemCloseTimer) { clearTimeout(itemCloseTimer); itemCloseTimer = null; }
    modal.hidden = false;
    modal.classList.add('open');
    modal.classList.remove('sheet-in');
    void modal.offsetWidth;
    modal.classList.add('sheet-in');
    modal.querySelector('.modal').scrollTop = 0;
    document.body.style.overflow = 'hidden';
    document.getElementById('modalBack').focus();
  }
  function closeItem(){
    if (itemCloseTimer) return;
    if (reduceMotion) { finishCloseItem(); return; }
    modal.classList.remove('sheet-in');
    itemCloseTimer = setTimeout(function(){ itemCloseTimer = null; finishCloseItem(); }, 350);
  }
  function finishCloseItem(){
    if (modal.hidden) return;
    modal.classList.remove('open');
    modal.classList.remove('sheet-in');
    modal.hidden = true;
    document.body.style.overflow = '';
    renderCart();
    if (lastTrigger) {
      lastTrigger.scrollIntoView({block:'center'});
      lastTrigger.focus({preventScroll:true});
      lastTrigger = null;
    }
  }
  grid.addEventListener('click', function(e){
    var star = e.target.closest ? e.target.closest('.fav-star') : null;
    if (star) { e.stopPropagation(); triggerAnimClass(star, 'pop-star'); toggleFavorite(parseInt(star.getAttribute('data-fav'), 10)); return; }
    var card = e.target.closest ? e.target.closest('.menu-card') : null;
    if (card) openItem(parseInt(card.getAttribute('data-idx'), 10), card);
  });
  grid.addEventListener('keydown', function(e){
    if ((e.key === 'Enter' || e.key === ' ') && e.target.classList.contains('menu-card')) {
      e.preventDefault();
      openItem(parseInt(e.target.getAttribute('data-idx'), 10), e.target);
    }
  });
  document.getElementById('modalClose').addEventListener('click', closeItem);
  document.getElementById('modalBack').addEventListener('click', closeItem);
  document.getElementById('modalBackBottom').addEventListener('click', closeItem);
  modal.addEventListener('click', function(e){ if (e.target === modal) closeItem(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !modal.hidden) closeItem(); });
  document.getElementById('qtyMinus').addEventListener('click', function(){ if (qty > 1) { qty--; syncOrder(); } });
  document.getElementById('qtyPlus').addEventListener('click', function(){ if (qty < 20) { qty++; syncOrder(); } });

  // ===== Header menu search: live results + filters the menu grid =====
  var searchToggle = document.getElementById('searchToggle');
  var searchPanel = document.getElementById('searchPanel');
  var searchInput = document.getElementById('searchInput');
  var searchClear = document.getElementById('searchClear');
  var searchDone = document.getElementById('searchDone');
  var searchStatus = document.getElementById('searchStatus');
  var searchResults = document.getElementById('searchResults');
  var searchQuery = '';
  var searchJumped = false;
  var emptyMsg = document.createElement('div');
  emptyMsg.className = 'menu-empty';
  emptyMsg.hidden = true;
  emptyMsg.textContent = 'Nothing on the menu matches that search — try \u201Cpoke\u201D, \u201Cmatcha\u201D or \u201Conigiri\u201D.';
  grid.appendChild(emptyMsg);

  function itemMatches(item, q){
    var hay = (item.n + ' ' + (item.d || '') + ' ' + item.s).toLowerCase();
    return q.split(/\s+/).every(function(w){ return hay.indexOf(w) !== -1; });
  }
  function applyTabFilter(){
    var sel = document.querySelector('.menu-tabs button[aria-selected="true"]');
    var f = sel ? sel.getAttribute('data-filter') : 'all';
    if (f === 'favs') { applyFavFilter(); return; }
    hideFavEmpty();
    filterables.forEach(function(el){
      el.style.display = (f === 'all' || el.getAttribute('data-cat') === f) ? '' : 'none';
    });
    emptyMsg.hidden = true;
  }
  function applySearch(){
    var q = searchQuery.trim().toLowerCase();
    searchClear.classList.toggle('show', !!q);
    if (!q) {
      applyTabFilter();
      searchStatus.hidden = true;
      searchStatus.textContent = '';
      searchResults.innerHTML = '';
      return;
    }
    var matches = [];
    MENU.forEach(function(item, idx){ if (itemMatches(item, q)) matches.push(idx); });
    var matchSet = {};
    matches.forEach(function(i){ matchSet[i] = true; });
    // Show only matching cards; a subcategory heading stays only if a match sits under it
    var headEl = null, headHas = false;
    function flushHead(){ if (headEl) headEl.style.display = headHas ? '' : 'none'; }
    Array.prototype.slice.call(grid.children).forEach(function(el){
      if (el.classList.contains('menu-subhead')) { flushHead(); headEl = el; headHas = false; }
      else if (el.classList.contains('menu-card')) {
        var vis = !!matchSet[parseInt(el.getAttribute('data-idx'), 10)];
        el.style.display = vis ? '' : 'none';
        if (vis) headHas = true;
      }
    });
    flushHead();
    emptyMsg.hidden = matches.length > 0;
    // Live result list under the search box — tap one to open that item
    searchResults.innerHTML = '';
    matches.slice(0, 8).forEach(function(idx){
      var item = MENU[idx];
      var li = document.createElement('li');
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'search-result';
      var rn = document.createElement('span'); rn.className = 'r-name'; rn.textContent = item.n;
      var rc = document.createElement('span'); rc.className = 'r-cat'; rc.textContent = item.s;
      var rp = document.createElement('span'); rp.className = 'r-price'; rp.textContent = money(item.p);
      b.appendChild(rn); b.appendChild(rc); b.appendChild(rp);
      b.addEventListener('click', function(){
        var card = grid.querySelector('.menu-card[data-idx="' + idx + '"]');
        openItem(idx, card || b);
      });
      li.appendChild(b);
      searchResults.appendChild(li);
    });
    searchStatus.hidden = false;
    if (matches.length) {
      searchStatus.textContent = matches.length + (matches.length === 1 ? ' item' : ' items') + ' found — tap one to view it, or browse the filtered menu below.' + (matches.length > 8 ? ' Showing the first 8 here; the rest are in the menu below.' : '');
    } else {
      searchStatus.textContent = 'No items match \u201C' + searchQuery.trim() + '\u201D.';
    }
  }
  function resetSearch(){
    searchInput.value = '';
    searchQuery = '';
    searchJumped = false;
    applySearch();
  }
  function setSearchOpen(open){
    searchPanel.hidden = !open;
    searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    syncHeaderHeight();
    if (open) searchInput.focus();
  }
  searchToggle.addEventListener('click', function(){ setSearchOpen(searchPanel.hidden); });
  searchDone.addEventListener('click', function(){ setSearchOpen(false); searchToggle.focus(); });
  searchClear.addEventListener('click', function(){ resetSearch(); searchInput.focus(); });
  searchInput.addEventListener('input', function(){
    var wasEmpty = !searchQuery.trim();
    searchQuery = searchInput.value;
    applySearch();
    if (wasEmpty && searchQuery.trim() && !searchJumped) {
      // First keystroke: jump down to the menu so the filtered results are in view
      searchJumped = true;
      document.getElementById('menu').scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth'});
    }
    if (!searchQuery.trim()) searchJumped = false;
  });
  searchInput.addEventListener('keydown', function(e){
    if (e.key === 'Enter') {
      e.preventDefault();
      document.getElementById('menu').scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth'});
    } else if (e.key === 'Escape') {
      setSearchOpen(false);
      searchToggle.focus();
    }
  });
  // Tapping a category tab hands the grid back to that tab's own filter
  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      if (searchQuery) {
        searchInput.value = '';
        searchQuery = '';
        searchJumped = false;
        searchStatus.hidden = true;
        searchStatus.textContent = '';
        searchResults.innerHTML = '';
        searchClear.classList.remove('show');
        emptyMsg.hidden = true;
      }
    });
  });

  // Signature Highlights: each card opens that exact menu item's detail view
  var sigCards = Array.prototype.slice.call(document.querySelectorAll('.sigcard'));
  sigCards.forEach(function(card){
    card.addEventListener('click', function(){
      var name = card.getAttribute('data-sig-name');
      var idx = -1;
      for (var i = 0; i < MENU.length; i++) { if (MENU[i].n === name) { idx = i; break; } }
      if (idx >= 0) openItem(idx, card);
    });
  });
  // Signature carousel: arrows + dots drive the swipeable row (same pattern as reactions)
  var sView = document.getElementById('sigViewport');
  if (sView) {
    var sDots = Array.prototype.slice.call(document.querySelectorAll('.sig-dots button'));
    function sStep(){ return sigCards.length > 1 ? (sigCards[1].offsetLeft - sigCards[0].offsetLeft) : sigCards[0].offsetWidth; }
    function sIndex(){
      var step = sStep(); if (!step) return 0;
      var i = Math.round(sView.scrollLeft / step);
      return Math.max(0, Math.min(sigCards.length - 1, i));
    }
    function sSync(){
      var i = sIndex();
      sDots.forEach(function(d, di){ d.setAttribute('aria-current', di === i ? 'true' : 'false'); });
    }
    function sGo(i){
      i = Math.max(0, Math.min(sigCards.length - 1, i));
      sView.scrollTo({left: i * sStep(), behavior: 'smooth'});
    }
    var sPrev = document.getElementById('sigPrev');
    var sNext = document.getElementById('sigNext');
    if (sPrev) sPrev.addEventListener('click', function(){ sGo(sIndex() - 1); });
    if (sNext) sNext.addEventListener('click', function(){ sGo(sIndex() + 1); });
    sDots.forEach(function(d){
      d.addEventListener('click', function(){ sGo(parseInt(d.getAttribute('data-sig-dot'), 10)); });
    });
    var sTick = false;
    sView.addEventListener('scroll', function(){
      if (!sTick) { sTick = true; window.requestAnimationFrame(function(){ sSync(); sTick = false; }); }
    }, {passive: true});
    sSync();
  }

  // Reaction carousel: arrows + dots drive the swipeable row
  var rView = document.getElementById('reactionViewport');
  if (rView) {
    var rCards = Array.prototype.slice.call(rView.querySelectorAll('.rcard'));
    var rDots = Array.prototype.slice.call(document.querySelectorAll('.reaction-dots button'));
    function rStep(){ return rCards.length > 1 ? (rCards[1].offsetLeft - rCards[0].offsetLeft) : rCards[0].offsetWidth; }
    function rIndex(){
      var step = rStep(); if (!step) return 0;
      var i = Math.round(rView.scrollLeft / step);
      return Math.max(0, Math.min(rCards.length - 1, i));
    }
    function rSync(){
      var i = rIndex();
      rDots.forEach(function(d, di){ d.setAttribute('aria-current', di === i ? 'true' : 'false'); });
    }
    function rGo(i){
      i = Math.max(0, Math.min(rCards.length - 1, i));
      rView.scrollTo({left: i * rStep(), behavior: 'smooth'});
    }
    var prevBtn = document.getElementById('reactionPrev');
    var nextBtn = document.getElementById('reactionNext');
    if (prevBtn) prevBtn.addEventListener('click', function(){ rGo(rIndex() - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function(){ rGo(rIndex() + 1); });
    rDots.forEach(function(d){
      d.addEventListener('click', function(){ rGo(parseInt(d.getAttribute('data-dot'), 10)); });
    });
    var rTick = false;
    rView.addEventListener('scroll', function(){
      if (!rTick) { rTick = true; window.requestAnimationFrame(function(){ rSync(); rTick = false; }); }
    }, {passive: true});
    rSync();
  }

  // Reaction reels: poster images only — each card links out to the original
  // reel on Instagram (no in-page embed player).

  // Open-now status in America/Los_Angeles time
  function cafeNow(){
    try {
      var parts = new Intl.DateTimeFormat('en-US',{timeZone:'America/Los_Angeles',weekday:'short',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(new Date());
      var map = {};
      parts.forEach(function(p){ map[p.type] = p.value; });
      var dayMap = {Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6};
      var day = dayMap[map.weekday];
      var mins = (parseInt(map.hour,10) % 24) * 60 + parseInt(map.minute,10);
      return {day: day, mins: mins};
    } catch(e) {
      var d = new Date();
      return {day: d.getDay(), mins: d.getHours()*60 + d.getMinutes()};
    }
  }
  var now = cafeNow();
  var isOpenDay = now.day >= 2 && now.day <= 6;
  var isOpen = isOpenDay && now.mins >= 660 && now.mins < 1110; // 11:00–18:30
  var msg;
  if (isOpen) { msg = 'Open now · today 11:00 AM – 6:30 PM'; }
  else if (isOpenDay && now.mins < 660) { msg = 'Opens today 11:00 AM – 6:30 PM'; }
  else if (now.day === 0 || now.day === 1) { msg = 'Closed today · opens Tuesday 11:00 AM – 6:30 PM'; }
  else {
    var names = {2:'tomorrow',3:'tomorrow',4:'tomorrow',5:'tomorrow',6:'Tuesday'};
    msg = 'Closed now · opens ' + names[now.day] + ' 11:00 AM – 6:30 PM';
  }
  ['statusText','statusText2'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.textContent = (id === 'statusText2') ? msg + ' · Open Tue–Sat 11:00 AM – 6:30 PM, closed Sun & Mon' : msg;
  });
  var todayHoursEl = document.getElementById('todayHours');
  if (todayHoursEl) {
    todayHoursEl.textContent = isOpenDay
      ? 'Today: 11:00 AM – 6:30 PM'
      : 'Today: Closed';
  }
  ['statusDot','statusDot2'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.classList.add(isOpen ? 'open' : 'closed');
  });
  // Highlight today's row
  var rows = document.querySelectorAll('#hoursTable tr');
  rows.forEach(function(r){
    if (parseInt(r.getAttribute('data-day'),10) === now.day) {
      r.classList.add('today');
      var first = r.querySelector('td');
      if (first) first.textContent = first.textContent + ' · today';
    }
  });

  // ===== Merged pickup ordering: cart, checkout, staff board (this page only, pay at pickup) =====
  var cart = [];
  var orders = [];
  var orderSeq = 1001;
  var soundOn = true;
  var audioCtx = null;
  var staffFilter = 'active';
  var alertList = [];
  var alertDismissed = false;
  var lastPlacedId = null;
  // ===== Staff sign-in: one shared password for the whole team =====
  // OWNER: this is the SHA-256 hash of the shared test password — the password itself is
  // never stored or printed in this page. Change it before going live by replacing this
  // hash with the SHA-256 hash of the new password. The current test password is shared
  // with the owner out-of-band, not in this file.
  var STAFF_PASSWORD_HASH = ''; // staff sign-in is checked on the server now (/api/staff/login); no password or hash lives in this page.
  var staffAuthed = false; // in-memory only for this page session — never saved to localStorage
  function __staffToken(){ try { return window.sessionStorage.getItem('sodam_staff_token') || ''; } catch(e){ return ''; } }
  function __setStaffToken(t){ try { if (t) window.sessionStorage.setItem('sodam_staff_token', t); else window.sessionStorage.removeItem('sodam_staff_token'); } catch(e){} }
  var cartModal = document.getElementById('cartModal');
  function playChime(){
    try {
      if (!audioCtx) { var C = window.AudioContext || window.webkitAudioContext; if (!C) return; audioCtx = new C(); }
      audioCtx.resume();
      [880, 1174.66, 880, 1174.66].forEach(function(freq, idx){
        var osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
        osc.type = 'sine'; osc.frequency.value = freq;
        var start = audioCtx.currentTime + idx * 0.18;
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.exponentialRampToValueAtTime(0.22, start + 0.03);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.34);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(start); osc.stop(start + 0.36);
      });
    } catch(e) {}
  }
  function fmtTime(mins){
    var h = Math.floor(mins / 60), m = mins % 60, ap = h >= 12 ? 'PM' : 'AM', hh = h % 12; if (hh === 0) hh = 12;
    return hh + ':' + (m < 10 ? '0' + m : m) + ' ' + ap;
  }
  function buildPickupSlots(){
    var sel = document.getElementById('coPickup');
    sel.innerHTML = '';
    var dayFmt = new Intl.DateTimeFormat('en-US', {timeZone:'America/Los_Angeles', weekday:'short'});
    var dateFmt = new Intl.DateTimeFormat('en-US', {timeZone:'America/Los_Angeles', weekday:'short', month:'short', day:'numeric'});
    var nowParts = new Intl.DateTimeFormat('en-US', {timeZone:'America/Los_Angeles', hour:'numeric', minute:'numeric', hour12:false}).formatToParts(new Date());
    var nm = {}; nowParts.forEach(function(x){ nm[x.type] = x.value; });
    var nowMins = (parseInt(nm.hour,10) % 24) * 60 + parseInt(nm.minute,10);
    var todayStr = dateFmt.format(new Date());
    var dayMap = {Sun:0, Mon:1, Tue:2, Wed:3, Thu:4, Fri:5, Sat:6};
    var added = 0;
    for (var off = 0; off < 8 && added < 120; off++) {
      var d = new Date(Date.now() + off * 86400000);
      var wd = dayMap[dayFmt.format(d)];
      if (wd < 2 || wd > 6) continue;
      var isToday = dateFmt.format(d) === todayStr;
      var dayLabel = (isToday ? 'Today · ' : '') + dateFmt.format(d);
      for (var mins = 660; mins <= 1110; mins += 15) {
        if (isToday && mins <= nowMins + 20) continue;
        var o = document.createElement('option');
        o.value = dayLabel + ' · ' + fmtTime(mins);
        o.textContent = o.value;
        sel.appendChild(o);
        added++;
      }
    }
    if (!sel.options.length) {
      var o2 = document.createElement('option');
      o2.value = ''; o2.textContent = 'No pickup times in the next few open days — please call the cafe';
      sel.appendChild(o2);
    }
  }
  function cartTotalCents(){ return cart.reduce(function(s,l){ return s + Math.round(l.unitPrice*100)*l.quantity; }, 0); }
  function cartCountTotal(){ return cart.reduce(function(s,l){ return s + l.quantity; }, 0); }
  function renderCart(){
    document.getElementById('cartCount').textContent = cartCountTotal();
    var fc = document.getElementById('floatCart');
    var showFloat = cart.length > 0 && cartModal.hidden && modal.hidden && !document.getElementById('confirmation') ? true : cart.length > 0 && cartModal.hidden && modal.hidden;
    fc.classList.toggle('show', cart.length > 0 && cartModal.hidden && modal.hidden);
    document.getElementById('floatCartLabel').textContent = 'View order · ' + cartCountTotal() + (cartCountTotal() === 1 ? ' item' : ' items');
    document.getElementById('floatCartTotal').textContent = money(cartTotalCents()/100);
    var wrap = document.getElementById('cartLines');
    wrap.innerHTML = '';
    cart.forEach(function(line){
      var div = document.createElement('div'); div.className = 'cart-line';
      var head = document.createElement('div'); head.className = 'cart-line-head';
      var nm = document.createElement('strong'); nm.textContent = line.name;
      var pr = document.createElement('strong'); pr.textContent = money(line.unitPrice * line.quantity);
      head.appendChild(nm); head.appendChild(pr); div.appendChild(head);
      if (line.options.length) { var op = document.createElement('p'); op.className = 'opts'; op.textContent = line.options.join(' · '); div.appendChild(op); }
      if (line.notes) { var nt = document.createElement('p'); nt.className = 'note'; nt.textContent = 'Note: ' + line.notes; div.appendChild(nt); }
      var foot = document.createElement('div'); foot.className = 'cart-line-foot';
      var q = document.createElement('span'); q.className = 'qty';
      var minus = document.createElement('button'); minus.type = 'button'; minus.textContent = '−'; minus.setAttribute('aria-label','One less ' + line.name);
      var out = document.createElement('output'); out.textContent = line.quantity;
      var plus = document.createElement('button'); plus.type = 'button'; plus.textContent = '+'; plus.setAttribute('aria-label','One more ' + line.name);
      minus.addEventListener('click', function(){ line.quantity--; if (line.quantity <= 0) cart = cart.filter(function(x){ return x !== line; }); renderCart(); });
      plus.addEventListener('click', function(){ if (line.quantity < 20) line.quantity++; renderCart(); });
      q.appendChild(minus); q.appendChild(out); q.appendChild(plus);
      var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'remove-line'; rm.textContent = 'Remove';
      rm.addEventListener('click', function(){ cart = cart.filter(function(x){ return x !== line; }); renderCart(); });
      foot.appendChild(q); foot.appendChild(rm); div.appendChild(foot);
      wrap.appendChild(div);
    });
    document.getElementById('cartEmpty').style.display = cart.length ? 'none' : '';
    document.getElementById('checkoutForm').style.display = cart.length ? '' : 'none';
    document.getElementById('coTotal').textContent = money(cartTotalCents()/100);
  }
  function openCart(){
    // Always opens the pickup cart in place on this page — no navigation, no link, no page change.
    if (!modal.hidden) { modal.classList.remove('open'); modal.hidden = true; }
    if (!signinModal.hidden) { signinModal.classList.remove('open'); signinModal.hidden = true; }
    var ssm = document.getElementById('staffSigninModal'); if (ssm && !ssm.hidden) { ssm.classList.remove('open'); ssm.hidden = true; }
    buildPickupSlotsIfEmpty();
    prefillCheckout();
    updateCartNote();
    renderCart();
    cartModal.hidden = false; cartModal.classList.add('open');
    cartModal.querySelector('.modal').scrollTop = 0;
    document.body.style.overflow = 'hidden';
    document.getElementById('floatCart').classList.remove('show');
  }
  function buildPickupSlotsIfEmpty(){
    var sel = document.getElementById('coPickup');
    if (!sel.options.length) buildPickupSlots();
  }
  function closeCart(){
    cartModal.classList.remove('open'); cartModal.hidden = true;
    document.body.style.overflow = '';
    renderCart();
  }
  function openCartFromTap(e){
    // Swallow the tap completely so it can never be treated as a navigation or fall through to anything under the bar.
    if (e) { e.preventDefault(); e.stopPropagation(); }
    openCart();
  }
  document.getElementById('cartBtn').addEventListener('click', openCartFromTap);
  document.getElementById('floatCartBtn').addEventListener('click', openCartFromTap);
  document.getElementById('cartClose').addEventListener('click', closeCart);
  document.getElementById('cartBack').addEventListener('click', closeCart);
  cartModal.addEventListener('click', function(e){ if (e.target === cartModal) closeCart(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !cartModal.hidden) closeCart(); });

  function collectOptions(){
    var opts = [];
    modalGroups.querySelectorAll('.opt-group').forEach(function(gr){
      var title = gr.querySelector('h5') ? gr.querySelector('h5').textContent : '';
      var isExtra = title.indexOf('Extra') === 0;
      gr.querySelectorAll('label.opt').forEach(function(lab){
        var box = lab.querySelector('input');
        var val = lab.querySelector('span').textContent;
        if (isExtra) { if (box.checked) opts.push('Extra ' + val); }
        else if (!box.checked) opts.push('No ' + val);
      });
    });
    var exFlavor = document.getElementById('exFlavor'); if (exFlavor) opts.push((exFlavor.getAttribute('data-prefix') || 'Flavor') + ': ' + exFlavor.value);
    var exBase = document.getElementById('exBase'); if (exBase) opts.push('Base: ' + exBase.value);
    var exSweet = document.getElementById('exSweet'); if (exSweet) opts.push('Sweetness: ' + exSweet.value);
    var exIce = document.getElementById('exIce'); if (exIce) opts.push('Ice: ' + exIce.value);
    var tops = document.getElementById('exToppings');
    if (tops) tops.querySelectorAll('input:checked').forEach(function(b){ opts.push('Add ' + b.value); });
    return opts;
  }
  document.getElementById('addToOrder').addEventListener('click', function(){
    if (!currentItem) return;
    if (currentItem.o) return;
    var opts = collectOptions();
    var notes = modalNotes.value.trim();
    var sig = currentItem.n + '|' + opts.join('|') + '|' + notes;
    var existing = null;
    cart.forEach(function(l){ if (l.sig === sig) existing = l; });
    if (existing) existing.quantity = Math.min(20, existing.quantity + qty);
    else cart.push({sig: sig, name: currentItem.n, unitPrice: currentItem.p, quantity: qty, options: opts, notes: notes});
    closeItem();
    renderCart();
    bumpCartOnAdd();
    var toast = document.getElementById('addedToast');
    toast.textContent = 'Added ' + qty + ' × ' + currentItem.n + ' ✓';
    toast.classList.remove('toast-leaving');
    toast.classList.add('show');
    var toastSeq1 = ++toastSeq;
    setTimeout(function(){ if (toastSeq1 !== toastSeq) return; toast.classList.add('toast-leaving'); setTimeout(function(){ if (toastSeq1 !== toastSeq) return; toast.classList.remove('show'); toast.classList.remove('toast-leaving'); }, 250); }, 1750);
  });
  // Keep floating bar hidden while the item sheet is open
  var origRenderFloat = renderCart;

  var STATUS_META = [
    {key:'new', label:'New', next:'preparing', nextLabel:'Start Preparing'},
    {key:'preparing', label:'Preparing', next:'ready', nextLabel:'Mark Ready'},
    {key:'ready', label:'Ready for Pickup', next:'picked_up', nextLabel:'Mark Picked Up'},
    {key:'picked_up', label:'Picked Up', next:null, nextLabel:''}
  ];
  function statusLabel(k){ for (var i=0;i<STATUS_META.length;i++) if (STATUS_META[i].key===k) return STATUS_META[i].label; return k; }
  function renderConfirmation(){
    var box = document.getElementById('confirmBox');
    var sec = document.getElementById('confirmation');
    var order = null;
    orders.forEach(function(o){ if (o.id === lastPlacedId) order = o; });
    if (!order) { sec.hidden = true; return; }
    sec.hidden = false;
    var steps = ['Order received','Preparing','Ready for pickup','Picked up'];
    var keys = ['new','preparing','ready','picked_up'];
    var cur = keys.indexOf(order.status);
    var html = '<p class="kicker" style="color:var(--persimmon);font-family:Oswald,sans-serif;font-size:13px;letter-spacing:.3em;text-transform:uppercase;font-weight:600;margin:0 0 10px">Order placed — pay at pickup</p>';
    html += '<h3>Order ' + order.number + '</h3>';
    html += '<p class="modal-desc">For ' + order.name + ' · Pickup: <strong>' + order.pickupLabel + '</strong><br />' + money(order.totalCents/100) + ' due at pickup · 23211 Hawthorne Blvd, Suite 100, Torrance · Questions? Call <a href="tel:+12132473453">(213) 247-3453</a></p>';
    html += '<ol class="status-steps">';
    steps.forEach(function(s,i){ html += '<li class="' + (i <= cur ? 'done' : '') + '">' + s + '</li>'; });
    html += '</ol><ul style="margin:16px 0 0;padding:14px 0 0 18px;border-top:1px solid var(--line)">';
    order.items.forEach(function(it){ html += '<li><strong>' + it.quantity + ' ×</strong> ' + it.name + (it.options.length ? '<span class="o-opts" style="display:block;color:var(--ink-soft);font-size:14px">' + it.options.join(' · ') + '</span>' : '') + (it.notes ? '<span style="display:block;color:var(--persimmon-deep);font-size:14px;font-weight:500">Note: ' + it.notes + '</span>' : '') + '</li>'; });
    html += '</ul><p class="modal-note">Status above updates on this page as the cafe prepares your order.</p>';
    box.innerHTML = html;
  }
  function esc(s){ var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  var __staffFetching = false;
  var __lastStaffIds = '';
  function renderStaff(){
    if (!staffAuthed) {
      var lockedBoard = document.getElementById('staffBoard');
      if (lockedBoard) lockedBoard.innerHTML = '';
      var c0 = document.getElementById('staffCounts');
      if (c0) c0.textContent = '0 new · 0 preparing · 0 ready';
      return;
    }
    if (__staffFetching) return;
    __staffFetching = true;
    fetch('/api/staff/orders', {headers:{'Authorization':'Bearer ' + __staffToken()}})
    .then(function(r){ if(!r.ok) throw new Error('staff orders failed'); return r.json(); })
    .then(function(list){
      __staffFetching = false;
      var ids = list.map(function(o){ return o.id; }).join(',');
      var arrived = __lastStaffIds && ids !== __lastStaffIds && list.length && list[0].status === 'new';
      __lastStaffIds = ids;
      orders.length = 0; list.forEach(function(o){ orders.push(o); });
      list.forEach(function(o){ if (o.status === 'new' && alertList.indexOf(o.id) === -1) alertList.push(o.id); });
      syncAlerts();
      if (arrived && soundOn) playChime();
      __renderStaffList();
    })
    .catch(function(){ __staffFetching = false; __renderStaffList(); });
  }
  function __renderStaffList(){
    var counts = {new:0, preparing:0, ready:0, picked_up:0};
    orders.forEach(function(o){ counts[o.status]++; });
    document.getElementById('staffCounts').textContent = counts.new + ' new · ' + counts.preparing + ' preparing · ' + counts.ready + ' ready';
    var board = document.getElementById('staffBoard');
    board.innerHTML = '';
    if (!orders.length) {
      board.innerHTML = '<div class="order-card" style="text-align:center;padding:38px 20px"><h4>No orders yet</h4><p style="color:var(--ink-soft);margin:8px 0 0">When a customer places a pickup order on this page, it will appear here as New — with a banner and a chime.</p></div>';
      return;
    }
    var visible = orders.filter(function(o){
      if (staffFilter === 'all') return true;
      if (staffFilter === 'active') return o.status !== 'picked_up';
      return o.status === staffFilter;
    });
    if (!visible.length) { board.innerHTML = '<p class="menu-empty">No orders in this group right now.</p>'; return; }
    STATUS_META.forEach(function(meta){
      var group = visible.filter(function(o){ return o.status === meta.key; });
      if (!group.length) return;
      var h = document.createElement('h3'); h.className = 'staff-group-head'; h.textContent = meta.label + ' · ' + group.length;
      board.appendChild(h);
      group.forEach(function(o){
        var card = document.createElement('article'); card.className = 'order-card' + (alertList.indexOf(o.id) !== -1 ? ' fresh' : '');
        var itemsHtml = o.items.map(function(it){
          return '<li><strong>' + it.quantity + ' ×</strong> ' + esc(it.name) + ' — ' + money(it.unitPrice * it.quantity) + (it.options.length ? '<span class="o-opts">' + esc(it.options.join(' · ')) + '</span>' : '') + (it.notes ? '<span class="o-note">Note: ' + esc(it.notes) + '</span>' : '') + '</li>';
        }).join('');
        card.innerHTML =
          (alertList.indexOf(o.id) !== -1 ? '<span class="modal-badge">Just arrived</span>' : '') +
          '<div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start"><div><h4>' + o.number + '</h4><p style="margin:4px 0 0">' + esc(o.name) + ' · <a href="tel:' + esc(o.phone) + '">' + esc(o.phone) + '</a></p><p style="margin:2px 0 0;color:var(--ink-soft);font-size:14px">Placed ' + o.placedLabel + '</p></div><span class="pickup-chip">' + esc(o.pickupLabel) + '</span></div>' +
          '<ul>' + itemsHtml + '</ul>' +
          (o.notes ? '<p style="margin-top:10px"><strong>Order note:</strong> ' + esc(o.notes) + '</p>' : '') +
          '<div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:14px;border-top:1px solid var(--line);padding-top:14px"><strong style="font-size:19px">' + money(o.totalCents/100) + '</strong><span style="color:var(--ink-soft);font-size:13.5px">due at pickup</span>' +
          '<span style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:center"><select data-status-for="' + o.id + '" aria-label="Status for order ' + o.number + '" style="border:1.5px solid var(--line);border-radius:999px;background:var(--card);color:var(--ink);padding:9px 12px;font:inherit;min-height:44px">' +
          STATUS_META.map(function(m){ return '<option value="' + m.key + '"' + (m.key === o.status ? ' selected' : '') + '>' + m.label + '</option>'; }).join('') +
          '</select>' +
          (meta.next ? '<button type="button" class="pill-btn" data-next-for="' + o.id + '" data-next="' + meta.next + '" aria-pressed="true">' + meta.nextLabel + '</button>' : '') +
          '</span></div>';
        board.appendChild(card);
      });
    });
  }
  document.getElementById('staffBoard').addEventListener('change', function(e){
    var sel = e.target.closest ? e.target.closest('select[data-status-for]') : null;
    if (!sel) return;
    var id = parseInt(sel.getAttribute('data-status-for'), 10);
    fetch('/api/staff/orders/' + id + '/status', {method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer ' + __staffToken()}, body: JSON.stringify({status: sel.value})}).catch(function(){});
    orders.forEach(function(o){ if (o.id === id) o.status = sel.value; });
    if (sel.value !== 'new') alertList = alertList.filter(function(x){ return x !== id; });
    syncAlerts(); renderStaff(); renderConfirmation();
  });
  document.getElementById('staffBoard').addEventListener('click', function(e){
    var btn = e.target.closest ? e.target.closest('button[data-next-for]') : null;
    if (!btn) return;
    var id = parseInt(btn.getAttribute('data-next-for'), 10);
    var __next = btn.getAttribute('data-next');
    fetch('/api/staff/orders/' + id + '/status', {method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer ' + __staffToken()}, body: JSON.stringify({status: __next})}).catch(function(){});
    orders.forEach(function(o){ if (o.id === id) o.status = __next; });
    alertList = alertList.filter(function(x){ return x !== id; });
    syncAlerts(); renderStaff(); renderConfirmation();
  });
  document.getElementById('staffFilters').addEventListener('click', function(e){
    var btn = e.target.closest ? e.target.closest('button[data-sfilter]') : null;
    if (!btn) return;
    staffFilter = btn.getAttribute('data-sfilter');
    this.querySelectorAll('button').forEach(function(b){ b.setAttribute('aria-selected', b === btn ? 'true' : 'false'); });
    renderStaff();
  });
  function syncAlerts(){
    var act = staffAuthed ? orders.filter(function(o){ return alertList.indexOf(o.id) !== -1 && o.status === 'new'; }) : [];
    var show = act.length > 0 && !alertDismissed;
    document.getElementById('staffAlert').classList.toggle('show', show);
    document.getElementById('globalAlert').classList.toggle('show', show);
    if (act.length) {
      var txt = act.map(function(o){ return o.number + ' · ' + o.name + ' · ' + o.pickupLabel; }).join('  |  ');
      document.getElementById('staffAlertTitle').textContent = act.length === 1 ? 'New order received!' : act.length + ' new orders received!';
      document.getElementById('staffAlertText').textContent = txt;
      document.getElementById('globalAlertText').textContent = txt;
    }
  }
  function dismissAlerts(){ alertDismissed = true; syncAlerts(); }
  document.getElementById('staffAlertDismiss').addEventListener('click', dismissAlerts);
  document.getElementById('globalAlertDismiss').addEventListener('click', dismissAlerts);
  function viewNew(){
    if (!staffAuthed) { openStaffSignin(); return; }
    staffFilter = 'new';
    document.querySelectorAll('#staffFilters button').forEach(function(b){ b.setAttribute('aria-selected', b.getAttribute('data-sfilter') === 'new' ? 'true' : 'false'); });
    renderStaff();
    document.getElementById('staff').scrollIntoView({behavior: 'auto'});
  }
  document.getElementById('staffAlertView').addEventListener('click', viewNew);
  document.getElementById('globalAlertView').addEventListener('click', viewNew);
  var soundToggle = document.getElementById('soundToggle');
  soundToggle.addEventListener('click', function(){
    soundOn = !soundOn;
    soundToggle.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
    soundToggle.textContent = 'Alert Sound: ' + (soundOn ? 'On' : 'Off');
    if (soundOn) playChime();
  });
  document.getElementById('soundTest').addEventListener('click', playChime);

  // ===== Staff sign-in gate: board, alerts and chime stay hidden until staff sign in =====
  var staffSigninModal = document.getElementById('staffSigninModal');
  function renderStaffGate(){
    var locked = document.getElementById('staffLocked');
    var wrap = document.getElementById('staffBoardWrap');
    if (locked) locked.hidden = staffAuthed;
    if (wrap) wrap.hidden = !staffAuthed;
    if (!staffAuthed) {
      var ga = document.getElementById('globalAlert'); if (ga) ga.classList.remove('show');
      var sa = document.getElementById('staffAlert'); if (sa) sa.classList.remove('show');
    }
    renderStaff();
    syncAlerts();
  }
  function openStaffSignin(){
    if (staffAuthed) { document.getElementById('staff').scrollIntoView({behavior: 'auto'}); return; }
    var err = document.getElementById('staffPwError'); if (err) err.hidden = true;
    var pw = document.getElementById('staffPw'); if (pw) pw.value = '';
    staffSigninModal.hidden = false; staffSigninModal.classList.add('open');
    staffSigninModal.querySelector('.modal').scrollTop = 0;
    document.body.style.overflow = 'hidden';
    if (pw) pw.focus();
  }
  function closeStaffSignin(){
    staffSigninModal.classList.remove('open'); staffSigninModal.hidden = true;
    if (cartModal.hidden && modal.hidden && signinModal.hidden) document.body.style.overflow = '';
  }
  function staffPwFail(){
    var err = document.getElementById('staffPwError');
    if (err) { err.textContent = 'That\u2019s not the staff password — check with the owner and try again. (Customers: this sign-in is for staff only; you don\u2019t need it to order.)'; err.hidden = false; }
    document.getElementById('staffPw').select();
  }
  // Small synchronous SHA-256 (public-domain style, geraintluff algorithm) — used instead of
  // crypto.subtle so the staff check works instantly in every browser context, with no async hang.
  var sha256Hex = (function(){
    function rr(v, a){ return (v >>> a) | (v << (32 - a)); }
    var K = [], H = [], maxWord = Math.pow(2, 32), result = '';
    var primes = [], primeCounter = 0;
    function isPrime(n){ for (var i = 2; i <= Math.sqrt(n); i++) if (n % i === 0) return false; return true; }
    var p = 2;
    while (primeCounter < 64) {
      if (isPrime(p)) {
        primes.push(p);
        if (primeCounter < 8) H[primeCounter] = (Math.pow(p, 0.5) * maxWord) | 0;
        K[primeCounter] = (Math.pow(p, 1/3) * maxWord) | 0;
        primeCounter++;
      }
      p++;
    }
    return function(ascii){
      var words = [], asciiBitLength = ascii.length * 8;
      var hash = H.slice(0), i, j, byte;
      ascii += '\x80';
      while (ascii.length % 64 - 56) ascii += '\x00';
      for (i = 0; i < ascii.length; i++) {
        byte = ascii.charCodeAt(i);
        if (byte >> 8) return '';
        words[i >> 2] |= byte << ((3 - i) % 4) * 8;
      }
      words[words.length] = (asciiBitLength / maxWord) | 0;
      words[words.length] = asciiBitLength;
      for (j = 0; j < words.length;) {
        var w = words.slice(j, j += 16), oldHash = hash;
        hash = hash.slice(0, 8);
        for (i = 0; i < 64; i++) {
          var w15 = w[i - 15], w2 = w[i - 2], a = hash[0], e = hash[4];
          var temp1 = hash[7]
            + (rr(e, 6) ^ rr(e, 11) ^ rr(e, 25))
            + ((e & hash[5]) ^ (~e & hash[6]))
            + K[i]
            + (w[i] = i < 16 ? w[i] : (
                w[i - 16]
                + (rr(w15, 7) ^ rr(w15, 18) ^ (w15 >>> 3))
                + w[i - 7]
                + (rr(w2, 17) ^ rr(w2, 19) ^ (w2 >>> 10))
              ) | 0);
          var temp2 = (rr(a, 2) ^ rr(a, 13) ^ rr(a, 22))
            + ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]));
          hash = [(temp1 + temp2) | 0].concat(hash);
          hash[4] = (hash[4] + temp1) | 0;
          hash.length = 8;
        }
        for (i = 0; i < 8; i++) hash[i] = (hash[i] + oldHash[i]) | 0;
      }
      result = '';
      for (i = 0; i < 8; i++) {
        for (j = 3; j + 1; j--) {
          var b = (hash[i] >> (j * 8)) & 255;
          result += (b < 16 ? '0' : '') + b.toString(16);
        }
      }
      return result;
    };
  })();
  function tryStaffSignin(){
    var err = document.getElementById('staffPwError');
    var val = document.getElementById('staffPw').value;
    if (!val) { staffPwFail(); return; }
    fetch('/api/staff/login', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({password: val})})
    .then(function(r){ return r.json().then(function(j){ if(!r.ok) throw new Error(j.error||'Wrong password'); return j; }); })
    .then(function(j){
      __setStaffToken(j.token);
      staffAuthed = true;
      if (err) err.hidden = true;
      closeStaffSignin();
      renderStaffGate();
      renderStaff();
      showToast('Staff signed in — Staff Board unlocked');
      document.getElementById('staff').scrollIntoView({behavior: 'auto'});
    })
    .catch(function(){ staffPwFail(); });
  }
  // Expose for other handlers defined earlier in this script (viewNew)
  window.__sodamOpenStaffSignin = openStaffSignin;
  var staffLockedBtn = document.getElementById('staffLockedBtn');
  if (staffLockedBtn) staffLockedBtn.addEventListener('click', openStaffSignin);
  var staffNavLink = document.getElementById('staffNavLink');
  if (staffNavLink) staffNavLink.addEventListener('click', function(e){
    if (!staffAuthed) { e.preventDefault(); openStaffSignin(); }
  });
  document.getElementById('staffSigninClose').addEventListener('click', closeStaffSignin);
  document.getElementById('staffSigninBack').addEventListener('click', closeStaffSignin);
  staffSigninModal.addEventListener('click', function(e){ if (e.target === staffSigninModal) closeStaffSignin(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !staffSigninModal.hidden) closeStaffSignin(); });
  document.getElementById('staffPwSubmit').addEventListener('click', tryStaffSignin);
  document.getElementById('staffPw').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); tryStaffSignin(); } });
  var staffSignOutBtn = document.getElementById('staffSignOut');
  if (staffSignOutBtn) staffSignOutBtn.addEventListener('click', function(){
    fetch('/api/staff/logout', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({token: __staffToken()})}).catch(function(){});
    __setStaffToken('');
    staffAuthed = false;
    renderStaffGate();
    showToast('Staff board locked — sign in again to view orders');
    document.getElementById('staff').scrollIntoView({behavior: 'auto'});
  });

  // ===== Regulars: simple sign-in (name + phone, no password), favorites + previous orders =====
  // First version to explore: sign-in, favorites, and order history are kept in this browser
  // (localStorage) on the customer's own device, keyed by phone number. Guest checkout is untouched.
  var LS_USER = 'sodam_regular_v1';
  var LS_HIST = 'sodam_history_v1';
  var LS_FAVS = 'sodam_favs_v1';
  var storeMem = {};
  var store = {
    get: function(k){ try { var v = window.localStorage.getItem(k); return v !== null ? v : (storeMem[k] || null); } catch(e){ return storeMem[k] || null; } },
    set: function(k, v){ storeMem[k] = v; try { window.localStorage.setItem(k, v); } catch(e){} },
    remove: function(k){ delete storeMem[k]; try { window.localStorage.removeItem(k); } catch(e){} }
  };
  function readJSON(k, fb){ var raw = store.get(k); if (!raw) return fb; try { var v = JSON.parse(raw); return v == null ? fb : v; } catch(e){ return fb; } }
  function writeJSON(k, v){ store.set(k, JSON.stringify(v)); }
  function phoneKey(p){ var d = (p || '').replace(/\D/g, ''); if (d.length > 10) d = d.slice(-10); return d; }
  var currentUser = readJSON(LS_USER, null);
  if (!currentUser || !currentUser.name || !phoneKey(currentUser.phone)) currentUser = null;
  var lastHistList = [];
  function historyMap(){ var h = readJSON(LS_HIST, {}); return (h && typeof h === 'object') ? h : {}; }
  function historyFor(key){ return historyMap()[key] || []; }
  function saveOrderToHistory(order){
    var key = phoneKey(order.phone); if (!key) return;
    var h = historyMap(); var list = h[key] || [];
    list.unshift({ number: order.number, name: order.name, phone: order.phone, pickupLabel: order.pickupLabel, notes: order.notes, totalCents: order.totalCents, placedLabel: order.placedLabel, items: order.items.map(function(it){ return {name: it.name, unitPrice: it.unitPrice, quantity: it.quantity, options: (it.options || []).slice(), notes: it.notes || '', sig: it.sig || ''}; }) });
    h[key] = list.slice(0, 20);
    writeJSON(LS_HIST, h);
  }
  function favsMap(){ var f = readJSON(LS_FAVS, {}); return (f && typeof f === 'object') ? f : {}; }
  function myFavIdxs(){ if (!currentUser) return []; var f = favsMap()[phoneKey(currentUser.phone)] || []; return f.filter(function(i){ return !!MENU[i]; }); }
  function setMyFavs(idxs){ var f = favsMap(); f[phoneKey(currentUser.phone)] = idxs; writeJSON(LS_FAVS, f); }
  var toastSeq = 0;
  function showToast(msg){
    var t = document.getElementById('addedToast');
    t.textContent = msg;
    t.classList.remove('toast-leaving');
    t.classList.add('show');
    var seq = ++toastSeq;
    setTimeout(function(){ if (seq !== toastSeq) return; t.classList.add('toast-leaving'); setTimeout(function(){ if (seq !== toastSeq) return; t.classList.remove('show'); t.classList.remove('toast-leaving'); }, 250); }, 2350);
  }
  function updateFavStars(){
    var favs = myFavIdxs();
    Array.prototype.slice.call(grid.querySelectorAll('.fav-star')).forEach(function(b){
      var idx = parseInt(b.getAttribute('data-fav'), 10);
      var on = !!currentUser && favs.indexOf(idx) !== -1;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      if (MENU[idx]) b.setAttribute('aria-label', on ? 'Remove ' + MENU[idx].n + ' from favorites' : 'Save ' + MENU[idx].n + ' as a favorite');
    });
  }
  function toggleFavorite(idx){
    if (!MENU[idx]) return;
    if (!currentUser) { openSignin(); showToast('Sign in to save favorites'); return; }
    var favs = myFavIdxs();
    var pos = favs.indexOf(idx);
    if (pos === -1) { favs.push(idx); showToast('Saved ' + MENU[idx].n + ' to your favorites'); }
    else { favs.splice(pos, 1); showToast('Removed ' + MENU[idx].n + ' from your favorites'); }
    setMyFavs(favs);
    fetch('/api/regulars/favourites', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({phone: currentUser.phone, itemId: idx + 1, on: favs.indexOf(idx) !== -1})}).catch(function(){});
    updateFavStars();
    renderAccount();
    var sel = document.querySelector('.menu-tabs button[aria-selected="true"]');
    if (sel && sel.getAttribute('data-filter') === 'favs') applyFavFilter();
  }
  var favEmpty = document.createElement('div');
  favEmpty.className = 'fav-empty';
  favEmpty.hidden = true;
  grid.appendChild(favEmpty);
  function hideFavEmpty(){ favEmpty.hidden = true; }
  function applyFavFilter(){
    var favs = myFavIdxs();
    var favSet = {};
    favs.forEach(function(i){ favSet[i] = true; });
    emptyMsg.hidden = true;
    Array.prototype.slice.call(grid.children).forEach(function(el){
      if (el.classList.contains('menu-subhead')) el.style.display = 'none';
      else if (el.classList.contains('menu-card')) el.style.display = favSet[parseInt(el.getAttribute('data-idx'), 10)] ? '' : 'none';
    });
    if (!currentUser) { favEmpty.textContent = 'Sign in to see your favorites.'; favEmpty.hidden = false; }
    else if (!favs.length) { favEmpty.textContent = 'No favorites yet — tap the star on the top-left corner of an item\u2019s photo to save it, and it will show up here with a quick Add to Order.'; favEmpty.hidden = false; }
    else favEmpty.hidden = true;
  }
  function quickAddItem(idx){
    var item = MENU[idx]; if (!item) return;
    if (item.f) { openItem(idx, null); return; } // filling/flavor picker items must be picked in the item sheet first
    if (item.o) { showToast('Sorry \u2014 ' + item.n + ' is out of stock right now.'); return; }
    var opts = [];
    if (item.k === 'bowl' && item.s === 'Bowls') opts.push('Base: ' + BOWL_BASES[0]);
    var sig = item.n + '|' + opts.join('|') + '|';
    var existing = null;
    cart.forEach(function(l){ if (l.sig === sig) existing = l; });
    if (existing) existing.quantity = Math.min(20, existing.quantity + 1);
    else cart.push({sig: sig, name: item.n, unitPrice: item.p, quantity: 1, options: opts, notes: ''});
    renderCart();
    bumpCartOnAdd();
    showToast('Added ' + item.n + ' to your pickup order');
  }
  function repeatOrder(o){
    if (!o) return;
    o.items.forEach(function(it){
      var sig = it.sig || (it.name + '|' + (it.options || []).join('|') + '|' + (it.notes || ''));
      var existing = null;
      cart.forEach(function(l){ if (l.sig === sig) existing = l; });
      if (existing) existing.quantity = Math.min(20, existing.quantity + it.quantity);
      else cart.push({sig: sig, name: it.name, unitPrice: it.unitPrice, quantity: it.quantity, options: (it.options || []).slice(), notes: it.notes || ''});
    });
    renderCart();
    showToast('Your previous order is back — pick a time and place it');
    openCart();
  }
  function prefillCheckout(){
    if (!currentUser) return;
    var n = document.getElementById('coName'), p = document.getElementById('coPhone');
    if (n && !n.value.trim()) n.value = currentUser.name;
    if (p && !p.value.trim()) p.value = currentUser.phone;
  }
  function updateCartNote(){
    var note = document.getElementById('cartAccountNote'); if (!note) return;
    note.innerHTML = '';
    if (currentUser) {
      note.innerHTML = 'Signed in as <strong>' + esc(currentUser.name) + '</strong> — this order will be saved to your history, so you can repeat it in one tap next time.';
    } else {
      note.appendChild(document.createTextNode('Ordering as a guest is fine — no sign-in needed. Regulars can '));
      var b = document.createElement('button'); b.type = 'button'; b.textContent = 'sign in with name & phone';
      b.addEventListener('click', function(){ closeCart(); openSignin(); });
      note.appendChild(b);
      note.appendChild(document.createTextNode(' to save favorites and repeat past orders.'));
    }
  }
  function renderAccount(){
    var label = document.getElementById('accountLabel');
    var btn = document.getElementById('accountBtn');
    var tabFavs = document.getElementById('tabFavs');
    if (tabFavs) tabFavs.hidden = !currentUser;
    if (currentUser) {
      label.textContent = 'Hi, ' + currentUser.name.split(/\s+/)[0];
      btn.setAttribute('aria-label', 'Signed in as ' + currentUser.name + ' — view your favorites and previous orders');
    } else {
      label.textContent = 'Sign in';
      btn.setAttribute('aria-label', 'Sign in as a regular — no password, just name and phone');
      if (tabFavs && tabFavs.getAttribute('aria-selected') === 'true') {
        var allTab = document.getElementById('tab-all');
        if (allTab) allTab.click();
      }
    }
    var body = document.getElementById('regularsBody');
    body.innerHTML = '';
    if (!currentUser) {
      var cta = document.createElement('div'); cta.className = 'regulars-cta';
      var p = document.createElement('p');
      p.innerHTML = '<strong>Been here before?</strong> Sign in to see your favorites and past orders — then tap <strong>Order again</strong> and your usual is back in your pickup order. Ordered as a guest before? Sign in with the same phone number and that order will show up here.';
      var sb = document.createElement('button'); sb.type = 'button'; sb.className = 'signin-btn'; sb.textContent = 'Sign In — Name & Phone Only';
      sb.addEventListener('click', openSignin);
      cta.appendChild(p); cta.appendChild(sb); body.appendChild(cta);
      updateFavStars(); updateCartNote();
      return;
    }
    var bar = document.createElement('div'); bar.className = 'signedin-bar';
    var who = document.createElement('p'); who.className = 'who';
    who.innerHTML = 'Signed in as <strong>' + esc(currentUser.name) + '</strong> · ' + esc(currentUser.phone);
    var out = document.createElement('button'); out.type = 'button'; out.className = 'signout-btn'; out.textContent = 'Sign out';
    out.addEventListener('click', function(){ currentUser = null; store.remove(LS_USER); renderAccount(); showToast('Signed out — guest ordering works as always'); });
    bar.appendChild(who); bar.appendChild(out); body.appendChild(bar);
    var fh = document.createElement('h3'); fh.className = 'subhead-reg'; fh.textContent = 'My Favorites'; body.appendChild(fh);
    var favs = myFavIdxs();
    if (!favs.length) {
      var fe = document.createElement('div'); fe.className = 'fav-empty'; fe.style.marginTop = '12px';
      fe.textContent = 'No favorites yet — tap the star on the top-left corner of an item\u2019s photo to save it here for a quick add next time.';
      body.appendChild(fe);
    } else {
      var fl = document.createElement('div'); fl.className = 'fav-list';
      favs.forEach(function(idx){
        var item = MENU[idx];
        var row = document.createElement('div'); row.className = 'fav-row';
        if (item.i >= 0 || typeof item.r === 'number') { var im = document.createElement('img'); im.src = imgPath(item.i >= 0 ? item.i : item.r); im.alt = ''; row.appendChild(im); }
        var info = document.createElement('div'); info.className = 'f-info';
        var nm = document.createElement('strong'); nm.textContent = item.n;
        var pr = document.createElement('span'); pr.textContent = money(item.p);
        info.appendChild(nm); info.appendChild(pr); row.appendChild(info);
        var add = document.createElement('button'); add.type = 'button'; add.className = 'f-add'; add.textContent = 'Add to Order';
        add.setAttribute('aria-label', 'Add ' + item.n + ' to your pickup order');
        add.addEventListener('click', function(){ quickAddItem(idx); });
        row.appendChild(add);
        var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'f-remove';
        rm.setAttribute('aria-label', 'Remove ' + item.n + ' from favorites');
        rm.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="#F6C945" stroke="#7A5200" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.8l2.85 5.9 6.45.85-4.7 4.5 1.15 6.4L12 17.35l-5.75 3.1 1.15-6.4-4.7-4.5 6.45-.85z"/></svg>';
        rm.addEventListener('click', function(){ toggleFavorite(idx); });
        row.appendChild(rm);
        fl.appendChild(row);
      });
      body.appendChild(fl);
    }
    var oh = document.createElement('h3'); oh.className = 'subhead-reg'; oh.textContent = 'Previous Orders'; body.appendChild(oh);
    var hist = historyFor(phoneKey(currentUser.phone));
    lastHistList = hist;
    if (!hist.length) {
      var he = document.createElement('div'); he.className = 'fav-empty'; he.style.marginTop = '12px';
      he.textContent = 'No previous orders yet — once you place a pickup order, it will appear here so you can repeat it in one tap.';
      body.appendChild(he);
    } else {
      var hg = document.createElement('div'); hg.className = 'hist-grid';
      hist.forEach(function(o){
        var card = document.createElement('article'); card.className = 'hist-card';
        var itemsHtml = o.items.map(function(it){ return '<li><strong>' + it.quantity + ' ×</strong> ' + esc(it.name) + (it.options && it.options.length ? '<span class="o-opts">' + esc(it.options.join(' · ')) + '</span>' : '') + (it.notes ? '<span class="o-note">Note: ' + esc(it.notes) + '</span>' : '') + '</li>'; }).join('');
        card.innerHTML = '<div class="h-top"><div><h4>' + esc(o.number) + '</h4><p class="h-when">Placed ' + esc(o.placedLabel) + ' · Pickup: ' + esc(o.pickupLabel) + '</p></div></div><ul>' + itemsHtml + '</ul>' + (o.notes ? '<p style="margin-top:10px"><strong>Order note:</strong> ' + esc(o.notes) + '</p>' : '') + '<div class="h-foot"><span class="h-total">' + money(o.totalCents / 100) + '</span><span style="color:var(--ink-soft);font-size:13.5px">paid at pickup</span></div>';
        var rb = document.createElement('button'); rb.type = 'button'; rb.className = 'repeat-btn'; rb.textContent = 'Order Again';
        rb.setAttribute('aria-label', 'Repeat order ' + o.number + ' — add its items to your pickup order');
        rb.addEventListener('click', function(){ repeatOrder(o); });
        card.querySelector('.h-foot').appendChild(rb);
        hg.appendChild(card);
      });
      body.appendChild(hg);
    }
    updateFavStars(); updateCartNote();
  }
  var signinModal = document.getElementById('signinModal');
  function openSignin(){
    document.getElementById('siError').hidden = true;
    if (currentUser) { document.getElementById('siName').value = currentUser.name; document.getElementById('siPhone').value = currentUser.phone; }
    signinModal.hidden = false; signinModal.classList.add('open');
    signinModal.querySelector('.modal').scrollTop = 0;
    document.body.style.overflow = 'hidden';
    document.getElementById('siName').focus();
  }
  function closeSignin(){
    signinModal.classList.remove('open'); signinModal.hidden = true;
    if (cartModal.hidden && modal.hidden) document.body.style.overflow = '';
  }
  document.getElementById('signinClose').addEventListener('click', closeSignin);
  document.getElementById('signinBack').addEventListener('click', closeSignin);
  signinModal.addEventListener('click', function(e){ if (e.target === signinModal) closeSignin(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !signinModal.hidden) closeSignin(); });
  document.getElementById('siSubmit').addEventListener('click', function(){
    var err = document.getElementById('siError');
    var name = document.getElementById('siName').value.trim();
    var phone = document.getElementById('siPhone').value.trim();
    if (!name) { err.textContent = 'Please enter your name — the same name you use for pickup.'; err.hidden = false; return; }
    if (phone.replace(/\D/g, '').length < 7) { err.textContent = 'Please enter the phone number you use for pickup.'; err.hidden = false; return; }
    err.hidden = true;
    currentUser = {name: name, phone: phone};
    writeJSON(LS_USER, currentUser);
    fetch('/api/regulars/signin', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name: name, phone: phone})})
    .then(function(r){ return r.json(); })
    .then(function(j){
      if (j && j.favourites) { var f = favsMap(); f[phoneKey(phone)] = j.favourites.map(function(id){ return id - 1; }).filter(function(i){ return !!MENU[i]; }); writeJSON(LS_FAVS, f); }
      if (j && j.orders) { var h = historyMap(); h[phoneKey(phone)] = j.orders; writeJSON(LS_HIST, h); }
      renderAccount(); updateFavStars();
    })
    .catch(function(){});
    closeSignin();
    renderAccount();
    prefillCheckout();
    showToast('Welcome, ' + name.split(/\s+/)[0] + ' — your favorites and past orders are ready');
    document.getElementById('regulars').scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth'});
  });
  document.getElementById('accountBtn').addEventListener('click', function(){
    if (currentUser) document.getElementById('regulars').scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth'});
    else openSignin();
  });
  var tabFavsEl = document.getElementById('tabFavs');
  if (tabFavsEl) tabFavsEl.addEventListener('click', function(){ applyFavFilter(); });
  tabs.forEach(function(t){ t.addEventListener('click', function(){ if (t.getAttribute('data-filter') !== 'favs') hideFavEmpty(); }); });
  function initAccount(){ renderAccount(); }

  document.getElementById('placeOrder').addEventListener('click', function(){
    var err = document.getElementById('coError');
    function fail(msg){ err.textContent = msg; err.hidden = false; }
    err.hidden = true;
    if (!cart.length) return fail('Your order is empty.');
    var name = document.getElementById('coName').value.trim();
    var phone = document.getElementById('coPhone').value.trim();
    var pickup = document.getElementById('coPickup').value;
    if (!name) return fail('Please enter the name for pickup.');
    if (phone.replace(/\D/g, '').length < 7) return fail('Please enter a phone number the cafe can reach.');
    if (!pickup) return fail('Please choose a pickup time (Tuesday–Saturday, 11:00 AM – 6:30 PM).');
    var placed = new Date();
    var order = {
      id: orderSeq, number: 'S-' + orderSeq,
      name: name, phone: phone, pickupLabel: pickup,
      notes: document.getElementById('coNotes').value.trim(),
      items: cart.map(function(l){ return {name: l.name, unitPrice: l.unitPrice, quantity: l.quantity, options: l.options.slice(), notes: l.notes, sig: l.sig}; }),
      totalCents: cartTotalCents(), status: 'new',
      placedLabel: placed.toLocaleString('en-US', {weekday:'short', hour:'numeric', minute:'2-digit'})
    };
    orderSeq++;
    (function(){
      var localOrder = order;
      fetch('/api/orders', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name: localOrder.name, phone: localOrder.phone, pickupLabel: localOrder.pickupLabel, notes: localOrder.notes, items: localOrder.items})})
      .then(function(r){ return r.json().then(function(j){ if(!r.ok) throw new Error(j.error||'Order failed'); return j; }); })
      .then(function(serverOrder){
        localOrder.id = serverOrder.id; localOrder.number = serverOrder.number; localOrder.totalCents = serverOrder.totalCents; localOrder.status = serverOrder.status; localOrder.placedLabel = serverOrder.placedLabel;
        orders.unshift(localOrder);
        lastPlacedId = localOrder.id;
        saveOrderToHistory(localOrder);
        cart = [];
        closeCart();
        renderCart(); renderStaff(); renderConfirmation(); renderAccount();
        alertList.unshift(localOrder.id);
        alertDismissed = false;
        syncAlerts();
        if (soundOn && staffAuthed) playChime();
        document.getElementById('confirmation').scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth'});
      })
      .catch(function(e){ err.textContent = 'Could not place the order — please try again. (' + e.message + ')'; err.hidden = false; });
    })();
  });

  buildPickupSlots();
  renderCart();
  renderStaffGate();
  initAccount();
  // Server replica: restore a staff session (token lives in this browser session only) and poll for new orders while the board is open.
  (function(){
    var t = __staffToken();
    if (t) {
      fetch('/api/staff/orders', {headers:{'Authorization':'Bearer ' + t}})
      .then(function(r){ if(!r.ok) throw new Error('no session'); return r.json(); })
      .then(function(){ staffAuthed = true; renderStaffGate(); renderStaff(); })
      .catch(function(){ __setStaffToken(''); });
    }
    setInterval(function(){ if (staffAuthed) renderStaff(); }, 10000);
  })();

})();
</script>
<script>
(function(){
  var qs = document.getElementById('qscroll');
  var thumb = document.getElementById('qscrollThumb');
  if (!qs || !thumb) return;
  var doc = document.documentElement;
  var dragging = false, grabOffset = 0, ticking = false;

  function metrics(){
    var trackH = qs.clientHeight - 20; // track has 10px top/bottom inset
    var docH = Math.max(doc.scrollHeight, document.body ? document.body.scrollHeight : 0);
    var viewH = window.innerHeight;
    var maxScroll = docH - viewH;
    var thumbH = maxScroll > 0 ? Math.max(52, Math.min(trackH, trackH * viewH / docH)) : trackH;
    return {trackH: trackH, maxScroll: maxScroll, thumbH: thumbH, travel: Math.max(0, trackH - thumbH)};
  }
  function update(){
    ticking = false;
    var m = metrics();
    if (m.maxScroll <= 4) { qs.hidden = true; return; }
    qs.hidden = false;
    var ratio = m.maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / m.maxScroll)) : 0;
    thumb.style.height = m.thumbH + 'px';
    thumb.style.top = (10 + ratio * m.travel) + 'px';
    qs.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
  }
  function requestUpdate(){
    if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
  }
  function scrollToRatio(ratio){
    var m = metrics();
    ratio = Math.min(1, Math.max(0, ratio));
    window.scrollTo(0, ratio * m.maxScroll);
  }
  function ratioFromY(clientY){
    var m = metrics();
    var rect = qs.getBoundingClientRect();
    var y = clientY - rect.top - 10 - grabOffset; // position of thumb top within track
    return m.travel > 0 ? y / m.travel : 0;
  }
  qs.addEventListener('pointerdown', function(e){
    var m = metrics();
    var rect = qs.getBoundingClientRect();
    var thumbTop = 10 + (m.maxScroll > 0 ? (window.scrollY / m.maxScroll) * m.travel : 0);
    var yInQs = e.clientY - rect.top;
    // If the grab starts on the thumb, keep the offset so it doesn't jump;
    // otherwise center the thumb on the tap point.
    grabOffset = (yInQs >= thumbTop && yInQs <= thumbTop + m.thumbH)
      ? (yInQs - thumbTop)
      : m.thumbH / 2;
    dragging = true;
    qs.classList.add('dragging');
    try { qs.setPointerCapture(e.pointerId); } catch(err) {}
    doc.style.scrollBehavior = 'auto';
    scrollToRatio(ratioFromY(e.clientY));
    e.preventDefault();
  });
  qs.addEventListener('pointermove', function(e){
    if (dragging) scrollToRatio(ratioFromY(e.clientY));
  });
  function endDrag(){
    if (!dragging) return;
    dragging = false;
    qs.classList.remove('dragging');
    doc.style.scrollBehavior = '';
    requestUpdate();
  }
  qs.addEventListener('pointerup', endDrag);
  qs.addEventListener('pointercancel', endDrag);
  qs.addEventListener('keydown', function(e){
    var m = metrics();
    var cur = m.maxScroll > 0 ? window.scrollY / m.maxScroll : 0;
    var step = 0.12, handled = true;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') scrollToRatio(cur + step);
    else if (e.key === 'ArrowUp' || e.key === 'PageUp') scrollToRatio(cur - step);
    else if (e.key === 'Home') scrollToRatio(0);
    else if (e.key === 'End') scrollToRatio(1);
    else handled = false;
    if (handled) e.preventDefault();
  });
  window.addEventListener('scroll', requestUpdate, {passive: true});
  window.addEventListener('resize', requestUpdate);
  window.addEventListener('load', requestUpdate);
  update();
})();
</script>
<script>
(function(){
  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Logo sheen replay: tapping/clicking the logo card replays the gold
  // sweep once. Purely visual — the tap keeps its normal behaviour.
  var logoCard = document.getElementById('logoCard');
  if (logoCard) {
    logoCard.addEventListener('click', function(){
      if (reducedMotion) return;
      logoCard.classList.remove('sheen-replay');
      void logoCard.offsetWidth;
      logoCard.classList.add('sheen-replay');
    });
  }

  // Scroll-reveal: hide elements only here (JS, immediately before
  // observing) so content is visible if JS fails. Reveal once.
  if (!reducedMotion && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    var observed = new WeakSet();
    var prepare = function(el){
      if (el.classList.contains('reveal-visible') || observed.has(el)) return;
      observed.add(el);
      if (!el.dataset.revealPrepared) {
        el.dataset.revealPrepared = '1';
        var group = el.closest('[data-reveal-group]');
        var delay = 0;
        if (group) {
          var siblings = Array.prototype.slice.call(group.querySelectorAll('[data-reveal]'));
          var idx = siblings.indexOf(el);
          if (idx >= 0) delay = Math.min(idx % 6, 5) * 90;
        }
        el.style.setProperty('--reveal-delay', delay + 'ms');
        el.classList.add('reveal-pending');
      }
      io.observe(el);
    };
    var scan = function(){
      document.querySelectorAll('[data-reveal]:not(.reveal-visible)').forEach(prepare);
    };
    scan();
    var mo = new MutationObserver(scan);
    mo.observe(document.body, { childList: true, subtree: true });
  }

  // Light parallax: one passive scroll listener throttled through
  // rAF. Writes the independent `translate` property directly on the
  // [data-parallax] photos (transform-only, clamped to ±16px, skipped
  // entirely under reduced motion).
  if (!reducedMotion) {
    var parallaxEls = Array.prototype.slice.call(document.querySelectorAll('[data-parallax]'));
    if (parallaxEls.length) {
      var raf = 0, fallback = 0, ticking = false;
      var update = function(){
        ticking = false;
        if (raf) cancelAnimationFrame(raf);
        if (fallback) window.clearTimeout(fallback);
        raf = 0; fallback = 0;
        var vh = window.innerHeight;
        parallaxEls.forEach(function(el){
          var rect = el.getBoundingClientRect();
          if (rect.bottom < -120 || rect.top > vh + 120) return;
          var centerDelta = rect.top + rect.height / 2 - vh / 2;
          var offset = Math.max(-16, Math.min(16, -centerDelta * 0.045));
          el.style.translate = '0px ' + offset.toFixed(1) + 'px';
        });
      };
      var onScroll = function(){
        if (ticking) return;
        ticking = true;
        raf = requestAnimationFrame(update);
        // Fallback for environments where rAF is starved: in a live
        // browser rAF always wins and this is a no-op.
        fallback = window.setTimeout(update, 90);
      };
      update();
      // Capture phase: scroll events don't bubble, but they do capture,
      // so this hears scrolling from any nested scroll container too.
      window.addEventListener('scroll', onScroll, { passive: true, capture: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }
  }
})();

</script>
</body>
</html>
